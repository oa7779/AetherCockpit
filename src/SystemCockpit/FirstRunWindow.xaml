<Window x:Class="SystemCockpit.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SystemCockpit.Controls"
        xmlns:loc="clr-namespace:SystemCockpit.Services"
        Title="{loc:DesktopLabel FirstRun.Title}" Width="1000" Height="760" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackdrop}" Foreground="#E1EAF7"
        FontFamily="Segoe UI" Icon="Assets/aether.ico">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource GlossButton}"/>
            <Setter Property="Foreground" Value="#DCEAF7"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E1EAF7"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="AETHER // SYSTEM CONTROL" Foreground="#D45CFF" FontFamily="Consolas" FontSize="26" FontWeight="Bold"/>
            <TextBlock x:Name="StepLabel" Text="{loc:DesktopLabel FirstRun.StepIntro}" Foreground="#24FFE3" FontFamily="Consolas" Margin="0,4,0,14"/>
        </StackPanel>

        <!-- Schritt 1: Einfuehrung / Funktionsuebersicht -->
        <ScrollViewer x:Name="StepIntro" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:DesktopLabel FirstRun.Introduction}"
                           FontSize="15" Margin="0,0,0,14"/>
                <TextBlock Text="{loc:DesktopLabel FirstRun.Features}" Foreground="#5DE5D0" FontFamily="Consolas" Margin="0,0,0,8"/>
                <TextBlock Text="{loc:DesktopLabel FirstRun.FeatureLive}"/>
                <TextBlock Text="{loc:DesktopLabel FirstRun.FeatureDesktop}"/>
                <TextBlock Text="{loc:DesktopLabel FirstRun.FeatureNetwork}"/>
                <TextBlock Text="{loc:DesktopLabel FirstRun.FeatureSensors}"/>
                <TextBlock Text="{loc:DesktopLabel FirstRun.FeatureRecording}"/>
                <TextBlock Text="{loc:DesktopLabel FirstRun.FeatureDiagnostics}"/>
                <TextBlock Text="{loc:DesktopLabel FirstRun.FeatureCleaner}"/>
                <TextBlock Text="{loc:DesktopLabel FirstRun.FeaturePackages}"/>
                <TextBlock Text="{loc:DesktopLabel FirstRun.FeatureCommands}"/>
                <TextBlock Text="{loc:DesktopLabel FirstRun.FeatureOperations}"/>
                <TextBlock Text="{loc:DesktopLabel FirstRun.FeatureTools}"/>
                <TextBlock Text="{loc:DesktopLabel FirstRun.SafetyHeading}" Foreground="#5DE5D0" FontFamily="Consolas" Margin="0,16,0,8"/>
                <TextBlock Text="{loc:DesktopLabel FirstRun.Safety}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Schritt 2: EULA -->
        <Grid x:Name="StepEula" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{loc:DesktopLabel FirstRun.LicenseNotice}"
                       Foreground="#FFB86C" Margin="0,0,0,10"/>
            <TextBox x:Name="EulaText" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5"
                     Background="#120C26" Foreground="#DCEAF7" BorderBrush="#7944B5"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="12"/>
            <CheckBox x:Name="AcceptCheck" Grid.Row="2" Margin="0,12,0,0" Foreground="#39FF68"
                      Content="{loc:DesktopLabel FirstRun.Accept}"
                      Checked="AcceptChanged" Unchecked="AcceptChanged"/>
        </Grid>

        <!-- Schritt 3: Inventar -->
        <Grid x:Name="StepInventory" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="{loc:DesktopLabel FirstRun.InventoryNotice}"
                       Foreground="#A8A4C5" Margin="0,0,0,12"/>
            <controls:InventoryView x:Name="Inventory" Grid.Row="1"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button x:Name="DeclineButton" Content="{loc:DesktopLabel FirstRun.Decline}" Click="DeclineClicked" HorizontalAlignment="Left" BorderBrush="#FF5470"/>
            <Button x:Name="BackButton" Content="{loc:DesktopLabel Common.Back}" Click="BackClicked" HorizontalAlignment="Right" Margin="0,0,320,0" Visibility="Collapsed"/>
            <Button x:Name="NextButton" Content="{loc:DesktopLabel FirstRun.NextLicense}" Click="NextClicked" HorizontalAlignment="Right" Width="300"/>
        </Grid>
    </Grid>
</Window>
