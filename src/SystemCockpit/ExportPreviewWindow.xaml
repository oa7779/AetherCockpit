<Window x:Class="SystemCockpit.ExportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AETHER / Diagnosebericht - Vorschau vor dem Speichern" Width="860" Height="620"
        WindowStartupLocation="CenterOwner" Background="#120C26">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="DIAGNOSEBERICHT / VORSCHAU" Foreground="#D45CFF" FontFamily="Consolas" FontSize="18"/>
            <TextBlock Text="Genau dieser Text wird gespeichert. Die Schwaerzung ersetzt Rechnername, Benutzername, Benutzerpfade sowie IPv4-/MAC-Adressen durch Platzhalter - Mustererkennung, keine Garantie: vor dem Teilen selbst pruefen."
                       Foreground="#A8A4C5" TextWrapping="Wrap" Margin="0,6,0,8"/>
            <CheckBox x:Name="RedactToggle" Content="Persoenliche Angaben schwaerzen (empfohlen fuer Foren/Support)" IsChecked="True"
                      Foreground="#24FFE3" Checked="RedactChanged" Unchecked="RedactChanged" Margin="0,0,0,8"/>
        </StackPanel>
        <TextBox x:Name="Preview" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 Background="#15102D" Foreground="#E1EAF7" BorderBrush="#7944B5"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                 AutomationProperties.Name="Berichtsvorschau"/>
        <WrapPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right">
            <Button Content="Als Textdatei speichern" Click="SaveClicked" Margin="0,0,10,0"/>
            <Button Content="Abbrechen" Click="CancelClicked"/>
        </WrapPanel>
    </Grid>
</Window>
