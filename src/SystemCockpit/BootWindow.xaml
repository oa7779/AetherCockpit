<Window x:Class="SystemCockpit.BootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AETHER | Neon Wave Boot | Olaf Weins" Width="980" Height="780" MinWidth="800" MinHeight="650"
        Background="#060313" Foreground="#83FFB0" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Icon="Assets/aether.ico">
    <Window.Resources>
        <DrawingBrush x:Key="BootScanlines" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
            <DrawingBrush.Drawing><GeometryDrawing Brush="#20000000">
                <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,1"/></GeometryDrawing.Geometry>
            </GeometryDrawing></DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="230"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ClipToBounds="True">
            <Grid.Background><RadialGradientBrush><GradientStop Color="#482055"/><GradientStop Color="#080517" Offset="1"/></RadialGradientBrush></Grid.Background>
            <Viewbox Stretch="Fill" Opacity="0.6"><Canvas Width="900" Height="220">
                <Path Data="M0,220 L450,60 L900,220 M90,220 L450,60 M200,220 L450,60 M310,220 L450,60 M590,220 L450,60 M700,220 L450,60 M810,220 L450,60 M0,190 L900,190 M70,150 L830,150 M170,110 L730,110 M270,85 L630,85"
                      Stroke="#FF35CB" StrokeThickness="1"/>
            </Canvas></Viewbox>
            <Border Width="240" Height="225" Background="#070513" BorderBrush="#FC46EA" BorderThickness="1" CornerRadius="24">
                <Border.Effect><DropShadowEffect Color="#D72FFF" BlurRadius="35" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                <Image x:Name="BootLogo" Source="/SystemCockpit;component/Assets/aether-logo.png" Margin="8" Stretch="Uniform"/>
            </Border>
            <Rectangle x:Name="Sweep" Width="110" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0.2">
                <Rectangle.Fill><LinearGradientBrush><GradientStop Color="#00FFFFFF"/><GradientStop Color="#FF9DFFFA" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                <Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,14,0,10">
            <TextBlock Text="AETHER // NEON WAVE SYSTEM BOOT" FontFamily="Consolas" FontSize="22" Foreground="#38FFF2"/>
            <TextBlock Text="Olaf Weins / Lokale Initialisierung / Keine Reparaturen oder Scans beim Boot" FontFamily="Consolas" FontSize="11" Foreground="#F078FF" Margin="0,5"/>
            <ProgressBar x:Name="BootProgress" Maximum="100" Height="7" Foreground="#36FFF0" Background="#38204E" BorderThickness="0"/>
        </StackPanel>
        <Border Grid.Row="2" CornerRadius="18" Padding="12" BorderBrush="#728F89" BorderThickness="3">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#72817E"/><GradientStop Color="#151E22" Offset="0.13"/><GradientStop Color="#090D11" Offset="0.8"/><GradientStop Color="#435D60" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid Background="#000603">
                <TextBox x:Name="BootOutput" Background="#000603" Foreground="#83FFB0" BorderThickness="0" Padding="12"
                         IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Bootkonsole"
                         TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                <Border Background="{StaticResource BootScanlines}" IsHitTestVisible="False"/>
                <Border Height="65" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#18FFFFFF"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background>
                </Border>
            </Grid>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button x:Name="ContinueButton" Content="Cockpit oeffnen / Hinweise gelesen" Visibility="Collapsed" Click="ContinueClicked" DockPanel.Dock="Right"
                    Foreground="#38FFF2" Background="#241333" BorderBrush="#F078FF" Padding="12,8"/>
            <TextBlock x:Name="BootStatus" Text="START / Lokale Komponenten werden vorbereitet ..." Foreground="#83FFB0" FontFamily="Consolas" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
