<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.7.0-beta.55</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.55</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\aether.ico</ApplicationIcon>
    <Authors>Olaf Weins</Authors>
    <Company>Olaf Weins</Company>
    <Product>AETHER System Control</Product>
    <Copyright>Copyright (c) 2026 Olaf Weins</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherOperations.Shared\AetherOperations.Shared.csproj" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <InternalsVisibleTo Include="SystemCockpit.Tests" />
    <InternalsVisibleTo Include="AetherScreensaver" />
    <Resource Include="Assets\aether-logo.png" LogicalName="Assets\aether-logo.png" />
    <Resource Include="Assets\aether.ico" />
    <None Remove="Assets\aether-logo.png" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\BETA-TESTANLEITUNG.md" Link="BETA-TESTANLEITUNG.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\CHANGELOG.md" Link="CHANGELOG.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\FEATURES.md" Link="docs\FEATURES.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\HARDWARE-SENSORS.md" Link="docs\HARDWARE-SENSORS.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\INSTALLATION.md" Link="docs\INSTALLATION.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\INTELLIGENCE-ARCHITECTURE.md" Link="docs\INTELLIGENCE-ARCHITECTURE.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\INTELLIGENCE-MODEL-INSTALLATION.md" Link="docs\INTELLIGENCE-MODEL-INSTALLATION.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\INTELLIGENCE-MODEL-MATRIX.md" Link="docs\INTELLIGENCE-MODEL-MATRIX.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\INTELLIGENCE-OPERATIONS.md" Link="docs\INTELLIGENCE-OPERATIONS.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\SECURITY-AND-PRIVACY.md" Link="docs\SECURITY-AND-PRIVACY.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\USER-GUIDE.md" Link="docs\USER-GUIDE.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\smartmontools-7.5-source.tar.gz" Link="tools\smartmontools-7.5-source.tar.gz" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\smartctl.exe" Link="tools\smartctl.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\provenance.json" Link="tools\provenance.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\PresentMon.exe" Link="tools\PresentMon.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\PresentMon-LICENSE.txt" Link="tools\PresentMon-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\drivedb.h" Link="tools\drivedb.h" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\COPYING.txt" Link="tools\COPYING.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="PublishDocumentationLogo" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\aether-logo.png"
          DestinationFiles="$(PublishDir)src\SystemCockpit\Assets\aether-logo.png" />
  </Target>

</Project>
