<Window x:Class="SystemCockpit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SystemCockpit.Controls"
        Title="AETHER | System Observatory | Olaf Weins" Width="1440" Height="940" MinWidth="1060" MinHeight="680"
        Background="{DynamicResource WindowBackdrop}" Foreground="#E1EAF7" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" Icon="Assets/aether.ico">
    <Window.Resources>
        <ResourceDictionary>
        <SolidColorBrush x:Key="Muted" Color="#A8A4C5"/>
        <DrawingBrush x:Key="ConsoleGrid" TileMode="Tile" Viewport="0,0,36,36" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#080516">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,36,36"/></GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen><Pen Brush="#171127" Thickness="0.5"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E1EAF7"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource NeonButton}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource NeonCheckBox}">
            <Setter Property="Foreground" Value="#CFDCEE"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="controls:FrameGlow.Enabled" Value="{Binding MotionEnabled}"/>
            <Setter Property="Background" Value="{DynamicResource GlossPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassRim}"/>
            <Setter Property="BorderThickness" Value="2,1,1,2"/>
            <Setter Property="CornerRadius" Value="22,5,22,5"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#B53CFF" BlurRadius="18" ShadowDepth="0" Opacity="0.28"/></Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource NeonDataGrid}"/>
        <DataTemplate x:Key="CheckTemplate">
            <Border Background="#15102D" CornerRadius="12,2,12,2" Padding="14" Margin="0,0,0,9" BorderBrush="#352451" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{Binding Accent}" CornerRadius="2"/>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{Binding Name}" Foreground="#9EB3CC" FontSize="12"/>
                        <TextBlock Text="{Binding Value}" Foreground="{Binding Accent}" FontSize="15" Margin="0,4,0,4" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DashboardGraphTemplate">
            <Border Background="{DynamicResource GlossPanel}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" CornerRadius="10,2,10,2" Margin="0,0,8,8" Padding="10">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                    <DockPanel Margin="0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Foreground="{Binding Accent}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/><controls:LedDisplay Text="{Binding NumericValue}" Accent="{Binding Accent}" Height="30" HorizontalAlignment="Left" Width="128"/></DockPanel>
                    <Viewbox Height="45" Stretch="Fill">
                        <Canvas Width="280" Height="56" Background="#0A0717">
                            <Line X1="0" Y1="28" X2="280" Y2="28" Stroke="#2D2248"/>
                            <Line X1="0" Y1="56" X2="280" Y2="56" Stroke="#2D2248"/>
                            <Polyline Points="{Binding Trace}" Stroke="{Binding Accent}" StrokeThickness="2"/>
                        </Canvas>
                    </Viewbox>
                    <ProgressBar Value="{Binding Level, Mode=OneWay}" Maximum="100" Height="6" Background="#2D2248" Foreground="{Binding Accent}" BorderThickness="0" Margin="0,5"/>
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CompactCoreTemplate">
            <Border Background="#090511" BorderBrush="#19A991" BorderThickness="1" Margin="2" Padding="4" CornerRadius="5">
                <Grid ToolTip="{Binding Detail}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/></Grid.RowDefinitions>
                    <DockPanel>
                        <controls:LedDisplay DockPanel.Dock="Right" Text="{Binding NumericValue}" Accent="#39FF68" Width="72" Height="24"/>
                        <TextBlock Text="{Binding Title}" Foreground="#24FFE3" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <Viewbox Grid.Row="1" Stretch="Fill" Margin="0,3">
                        <Canvas Width="180" Height="56" Background="#071711">
                            <Line X1="0" X2="180" Y1="28" Y2="28" Stroke="#19432B"/>
                            <Polyline Points="{Binding Trace}" Stroke="#39FF68" StrokeThickness="2" RenderTransformOrigin="0,0"><Polyline.RenderTransform><ScaleTransform ScaleX="0.643"/></Polyline.RenderTransform></Polyline>
                        </Canvas>
                    </Viewbox>
                    <ProgressBar Grid.Row="2" Value="{Binding Level, Mode=OneWay}" Maximum="100" Foreground="#39FF68" Background="#183426" BorderThickness="0"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CompactDiskTemplate">
            <Border Background="#120711" BorderBrush="#FF576E" BorderThickness="1" Margin="3" Padding="8" Height="92" CornerRadius="6">
                <Grid ToolTip="{Binding Detail}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="6"/></Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Foreground="#24FFE3" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <controls:LedDisplay DockPanel.Dock="Right" Text="{Binding NumericValue}" Accent="#FF354A" Width="96" Height="28"/>
                        <TextBlock Text="{Binding Title}" Foreground="#FF576E" FontFamily="Consolas" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Viewbox Grid.Row="1" Stretch="Fill" Margin="0,4"><Canvas Width="280" Height="56" Background="#08060C">
                        <Line X1="0" X2="280" Y1="28" Y2="28" Stroke="#392027"/><Polyline Points="{Binding Trace}" Stroke="#FF354A" StrokeThickness="2"/>
                    </Canvas></Viewbox>
                    <ProgressBar Grid.Row="2" Value="{Binding Level, Mode=OneWay}" Maximum="100" Foreground="#FF354A" Background="#391321" BorderThickness="0"/>
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource ConsoleGrid}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource ChromeSidebar}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="0,0,3,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,30,20,20">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource NeonButton}">
                        <Setter Property="Padding" Value="8,8"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                </StackPanel.Resources>
                <StackPanel DockPanel.Dock="Top">
                    <Image Source="Assets/aether-logo.png" Height="64" Stretch="Uniform" Margin="0,-15,0,8"/>
                    <TextBlock Text="A E T H E R" Foreground="#24FFE3" FontFamily="Consolas" FontSize="25" FontWeight="Bold">
                        <TextBlock.Effect><DropShadowEffect Color="#24FFE3" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/></TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="NEON WAVE / GLASS CONTROL" Foreground="#F56AFF" FontFamily="Consolas" FontSize="10" Margin="0,8,0,14"/>
                    <Border Background="#D45CFF" Height="12" CornerRadius="6,0,0,6" Margin="0,0,0,5"/>
                    <Border Background="#4294FF" Height="7" CornerRadius="4,0,0,4" Margin="22,0,0,18"/>
                    <TextBlock Text="KOMMANDOBRUECKE" FontFamily="Consolas" FontSize="10" Foreground="#32D5FF" Margin="0,0,0,12"/>
                    <Button Content="FUNKTION FINDEN" Click="TaskCenterClicked" HorizontalContentAlignment="Left" Margin="0,0,0,12" ToolTip="Arbeitsplatz mit Suchfunktion und gefuehrten Arbeitsablaeufen (Strg+K). Oeffnet nur Bereiche, startet keine Aktion."/>
                    <Button x:Name="CockpitNav" Content="01   Cockpit" Tag="Cockpit" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,8" BorderBrush="#24FFE3"/>
                    <Button Content="Mainboard / 1986" Tag="Mainboard" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,8" BorderBrush="#F56AFF"/>
                    <Button Content="02   Taskmanager" Tag="Taskmanager" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,8" BorderBrush="#24FFE3"/>
                    <Button Content="03   Sensor-Matrix" Tag="Sensoren" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,8" BorderBrush="#4294FF"/>
                    <Button Content="04   Laufwerke" Tag="Laufwerke" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                    <Button Content="05   Messauswertung" Tag="Messauswertung" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,8" BorderBrush="#24FFE3"/>
                    <Button Content="06   Diagnose" Tag="Diagnose" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,8" BorderBrush="#4294FF"/>
                    <Button Content="07   Sicherheit" Tag="Sicherheit" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,8" BorderBrush="#D45CFF"/>
                    <Button Content="08   Cleaner" Tag="Cleaner" Click="Navigate" HorizontalContentAlignment="Left" BorderBrush="#D45CFF"/>
                    <Button Content="09   Ereignisse" Tag="Ereignisse" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,6,0,6" BorderBrush="#F56AFF"/>
                    <Button Content="10   Superadmin" Tag="Superadmin" Click="Navigate" HorizontalContentAlignment="Left" BorderBrush="#32D5FF"/>
                    <Button Content="11   Operations" Tag="Operations" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,6,0,0" BorderBrush="#39FF68" ToolTip="Leistungsindex, Wartungsplaene, Geraetediagnose und lokale Cloud-Voraussetzungen"/>
                    <Button Content="12   Hilfe" Tag="Hilfe" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,6,0,0" BorderBrush="#DCA4FF" ToolTip="Durchsuchbare Anleitung zu jedem Modul"/>
                    <StackPanel>
                        <TextBlock Text="SYSTEMKONTROLLE / DIREKT" Foreground="#D45CFF" FontFamily="Consolas" FontSize="10" Margin="0,16,0,8"/>
                        <Button Content="Pakete / WinGet" Tag="Pakete" Click="ControlCenterNavigate" HorizontalContentAlignment="Left" Margin="0,0,0,6" BorderBrush="#39FF68" ToolTip="Paket-Center: installierte Pakete, Updates, Suche, Aktionen mit exakten IDs"/>
                        <Button Content="Befehls-Katalog" Tag="Wartung" Click="ControlCenterNavigate" HorizontalContentAlignment="Left" Margin="0,0,0,6" BorderBrush="#FFB86C" ToolTip="103 Windows-Befehle mit Risikoanzeige, Einsteiger-/Expertenmodus und CRT-Konsole"/>
                        <Button Content="SMART / Laufwerke" Tag="SMART" Click="ControlCenterNavigate" HorizontalContentAlignment="Left" Margin="0,0,0,6" BorderBrush="#32D5FF" ToolTip="Vollstaendige smartctl-Diagnose und Selbsttests"/>
                        <Button Content="Netzwerk / Tests" Tag="Netzwerk" Click="ControlCenterNavigate" HorizontalContentAlignment="Left" BorderBrush="#4294FF" ToolTip="Ping, LAN-Scan, WLAN, Captive Portal und Speedtest"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <CheckBox Content="Scanner-Animation" ToolTip="Scanner und animierte Neon-Rahmen ein/aus" IsChecked="{Binding MotionEnabled}"/>
                    <TextBlock Text="{Binding AccessStatus}" Foreground="#32D5FF" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,6,0,8"/>
                    <TextBlock Text="ADMIN / UAC beim Start" Foreground="#24FFE3" FontSize="11" Margin="0,0,0,14"/>
                    <Border BorderBrush="#6940A8" BorderThickness="1" CornerRadius="16,3,16,3" Padding="12">
                        <StackPanel>
                            <TextBlock Text="LOCAL FIRST" Foreground="#5DE5D0" FontSize="11"/>
                            <TextBlock Text="Einzelplatz ohne Serverkontakt. Berichte nur nach Freigabe und ausdruecklichem Opt-in." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="NATIVE / WINDOWS / v0.7" Foreground="#A8A4C5" FontFamily="Consolas" FontSize="10" Margin="0,16,0,0"/>
                    <TextBlock Text="Copyright (c) 2026 Olaf Weins" TextWrapping="Wrap" Foreground="#32D5FF" FontFamily="Consolas" FontSize="10" Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Column="1" Margin="28,12,28,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DEIN SYSTEM. DEINE KOMMANDOBRUECKE." Foreground="#24FFE3" FontFamily="Consolas" FontSize="11"/>
                    <TextBlock Text="System Observatory" Foreground="#DCA4FF" FontFamily="Consolas" FontSize="30" FontWeight="Bold" Margin="0,5,0,5"/>
                    <TextBlock Text="{Binding SystemIdentity}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <controls:LedDisplay Text="{Binding SystemClock}" Accent="#FF354A" Width="180" Height="32" ToolTip="Lokale Windows-Zeit / Aktualisierung mit Live-Messung"/>
                    <TextBlock Text="{Binding SystemUptime}" Foreground="#F56AFF" FontFamily="Consolas" HorizontalAlignment="Right" Margin="0,2,0,4"/>
                    <TextBlock Text="{Binding LiveStatus}" Foreground="#24FFE3" FontFamily="Consolas" HorizontalAlignment="Right" Margin="0,2,0,8"/>
                    <Button Content="Status aktualisieren" Click="RefreshClicked" IsEnabled="{Binding CanRefresh}"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" BorderBrush="#6940A8" BorderThickness="1" CornerRadius="8" Background="#140E2C" Padding="8,3" Margin="0,0,0,8">
                <DockPanel>
                    <Button x:Name="NavBack" Content="&#9664; ZURUECK" Click="NavBackClicked" IsEnabled="False" Margin="0,0,8,0" Padding="8,3" FontSize="11"
                            ToolTip="Zur vorherigen Ansicht zurueck - auch per Maus-Zurueck-Taste oder Alt+Pfeil links"/>
                    <Button x:Name="NavForward" Content="VOR &#9654;" Click="NavForwardClicked" IsEnabled="False" Margin="0,0,8,0" Padding="8,3" FontSize="11"
                            ToolTip="Wieder vorwaerts - auch per Maus-Vor-Taste oder Alt+Pfeil rechts"/>
                    <Button Content="&#8962; COCKPIT" Click="NavHomeClicked" Margin="0,0,8,0" Padding="8,3" FontSize="11"
                            ToolTip="Direkt zur Hauptebene (Cockpit)"/>
                    <Button Content="? HILFE" Click="NavHelpClicked" DockPanel.Dock="Right" Padding="8,3" FontSize="11"
                            ToolTip="Durchsuchbares Hilfe-Center oeffnen"/>
                    <TextBlock x:Name="NavTrail" Text="HAUPTEBENE &#9656; COCKPIT" Foreground="#24FFE3" FontFamily="Consolas" FontSize="12"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               ToolTip="Aktuelle Position. Zurueck/Vor folgen deinem Besuchsverlauf wie im Browser."/>
                </DockPanel>
            </Border>
            <TabControl x:Name="Pages" Grid.Row="2" SelectionChanged="PageChanged" Background="Transparent" Foreground="#E1EAF7" BorderThickness="0" Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style>
                </TabControl.Resources>
                <TabItem Header="Cockpit" ToolTip="Live-Instrumente: CPU, RAM, GPU, Netzwerk, Temperaturen und Systempuls">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="CPU // MEMORY // STORAGE // LIVE" Foreground="#39FF68" FontFamily="Consolas" FontSize="18"/>
                                    <TextBlock Text="{Binding CpuIdentity}" Foreground="#24FFE3" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="{Binding MemoryIdentity}" Foreground="#FD59FF" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border BorderBrush="#39FF68" BorderThickness="1" CornerRadius="8" Background="#07110E" Margin="0,0,8,8">
                                            <Grid DataContext="{Binding Cards[0]}">
                                                <controls:NeonGauge Level="{Binding Level}" Accent="#39FF68"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="CPU GESAMT / %" Foreground="#39FF68" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center"/>
                                                    <controls:LedDisplay Text="{Binding Value}" Accent="#39FF68" Height="36" Width="120" Margin="0,4"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding DetailGraphs}" ItemTemplate="{StaticResource DashboardGraphTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    </Grid>
                                    <WrapPanel><TextBlock Text="CPU TEMPERATUR: " Foreground="#FFCE54"/><TextBlock Text="{Binding CpuTemperature}" Foreground="#39FF68"/><TextBlock Text="   PACKAGE-LEISTUNG: " Foreground="#FFCE54"/><TextBlock Text="{Binding CpuPower}" Foreground="#39FF68"/></WrapPanel>
                                    <TextBlock Text="ALLE LOGISCHEN CPU-KERNE / 0..100% / 2s" Foreground="#24FFE3" FontFamily="Consolas" Margin="0,6"/>
                                    <ItemsControl x:Name="CockpitCoreOverview" ItemsSource="{Binding CoreGraphs}" ItemTemplate="{StaticResource CompactCoreTemplate}" Height="288">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CoreColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Text="PHYSISCHE DATENTRAEGER / READ, WRITE, AKTIVZEIT, QUEUE / 15s" Foreground="#FF576E" FontFamily="Consolas" Margin="0,8"/>
                                    <ItemsControl ItemsSource="{Binding DiskGraphs}" ItemTemplate="{StaticResource CompactDiskTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Background="#140D29" BorderBrush="#7842C6" BorderThickness="1" CornerRadius="18,2,18,2" Padding="12,6" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="A-01 // SYSTEM BUS" Foreground="#D45CFF" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    <Viewbox Grid.Column="1" Height="18" Stretch="Fill" Margin="18,0">
                                        <Canvas Width="480" Height="18" ClipToBounds="True">
                                            <Rectangle Width="480" Height="18" Fill="#251639"/>
                                            <Rectangle x:Name="Scanner" Width="70" Height="18" RadiusX="3" Fill="#24FFE3">
                                                <Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform>
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MotionEnabled}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="ScannerMotion">
                                                                        <Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="410" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="ScannerMotion"/></DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Grid.Column="2" Text="VISUAL SCANNER / KEIN NETZSCAN" Foreground="#32D5FF" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="MetricCards" ItemsSource="{Binding Cards}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Panel}" BorderBrush="{Binding Accent}" Margin="0,0,10,18" Padding="16">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}" FontSize="11" FontWeight="SemiBold"/>
                                                <Grid Height="150" Margin="0,6,0,8">
                                                    <controls:NeonGauge Level="{Binding Level}" Accent="{Binding Accent}"/>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <controls:LedDisplay Text="{Binding Value}" Accent="{Binding Accent}" Width="125" Height="38"/>
                                                        <TextBlock Text="{Binding Unit}" Foreground="{Binding Accent}" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" MinHeight="34"/>
                                                <Viewbox Height="56" Stretch="Fill" Margin="0,15,0,12">
                                                    <Canvas Width="280" Height="56">
                                                        <Line X1="0" Y1="56" X2="280" Y2="56" Stroke="#233A50"/>
                                                        <Polyline Points="{Binding Trace}" Stroke="{Binding Accent}" StrokeThickness="2"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Level}" Height="7" Foreground="{Binding Accent}" Background="#2D2248" BorderThickness="0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="TASKMANAGER / LIVE PERFORMANCE" Foreground="#24FFE3" FontFamily="Consolas" FontSize="19"/>
                                    <TextBlock Text="{Binding DashboardStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8"/>
                                    <Expander Header="NETZWERK / RX UND TX JE AKTIVEM ADAPTER" Foreground="#32D5FF" Margin="0,8">
                                        <ItemsControl ItemsSource="{Binding AdapterGraphs}" ItemTemplate="{StaticResource DashboardGraphTemplate}" Margin="0,10">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Expander>
                                    <Expander Header="VOLUMES / BELEGUNGSBALKEN UND VERLAUF" Foreground="#4294FF" Margin="0,8" IsExpanded="True">
                                        <ItemsControl ItemsSource="{Binding VolumeGraphs}" ItemTemplate="{StaticResource DashboardGraphTemplate}" Margin="0,10">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Expander>
                                    <Expander Header="SENSOREN / ALLE GEMELDETEN KANAELE MIT GRAPH UND BALKEN" Foreground="#D45CFF" Margin="0,8">
                                        <StackPanel>
                                            <TextBlock Text="Sensorzugriff unten separat aktivieren. Unlesbare Werte: --, nicht 0. Nichtprozentwerte nutzen dynamische Skalen, keine Warn-/Gesundheitsscores." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8"/>
                                            <ItemsControl ItemsSource="{Binding SensorGraphs}" ItemTemplate="{StaticResource DashboardGraphTemplate}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="PROZESSMONITOR / CPU / RAM / I/O" FontFamily="Consolas" Foreground="#24FFE3" FontSize="19"/>
                                    <TextBlock Text="CPU: Anteil an gesamter logischer CPU-Kapazitaet im Messintervall. RAM: Working Set, gemeinsame Seiten werden mehrfach gezaehlt. I/O: Prozesszaehler inklusive Datei/Geraet/Netzwerk, keine SSD-Bandbreite. Spalten anklicken zum Sortieren." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8"/>
                                    <TextBox Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" Background="#15102D" Foreground="#E1EAF7" BorderBrush="#7944B5" Padding="8" Margin="0,0,0,8" AutomationProperties.Name="Prozessfilter" ToolTip="Name, PID oder Status filtern"/>
                                    <DataGrid x:Name="DashboardProcesses" ItemsSource="{Binding ProcessView}" Height="330" EnableRowVirtualization="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="PROZESS" Binding="{Binding Name}" Width="2*"/>
                                            <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="75"/>
                                            <DataGridTemplateColumn Header="CPU %" SortMemberPath="CpuPercent" Width="110">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid>
                                                    <ProgressBar Value="{Binding CpuLevel, Mode=OneWay}" Maximum="100" Foreground="#225C59" Background="#15102D" BorderThickness="0"/>
                                                    <TextBlock Text="{Binding CpuDisplay}" Foreground="#24FFE3" VerticalAlignment="Center" Margin="5,0"/>
                                                </Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="RAM MB" SortMemberPath="MemoryMb" Width="100">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid>
                                                    <ProgressBar Value="{Binding MemoryMb, Mode=OneWay, TargetNullValue=0}" Maximum="{Binding DataContext.PhysicalMemoryMb, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                                                 Foreground="#253B67" Background="#15102D" BorderThickness="0"/>
                                                    <TextBlock Text="{Binding MemoryDisplay}" Foreground="#9DBDFF" VerticalAlignment="Center" Margin="5,0"/>
                                                </Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="THREADS" Binding="{Binding Threads}" Width="85"/>
                                            <DataGridTextColumn Header="HANDLES" Binding="{Binding Handles}" Width="90"/>
                                            <DataGridTextColumn Header="READ MB/s" Binding="{Binding ReadDisplay}" SortMemberPath="ReadMbps" Width="105"/>
                                            <DataGridTextColumn Header="WRITE MB/s" Binding="{Binding WriteDisplay}" SortMemberPath="WriteMbps" Width="110"/>
                                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="220"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="EVENTMONITOR / SYSTEM + APPLICATION" FontFamily="Consolas" Foreground="#D45CFF" FontSize="19"/>
                                    <TextBlock Text="{Binding EventStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8"/>
                                    <TextBlock Text="24H / STUNDENBUCKETS / nur die maximal 400 gelieferten Ereignisse, kein vollstaendiges Ereignisaufkommen" Foreground="#32D5FF" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding EventBuckets}" Height="115" Margin="0,0,0,12">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="24"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid Margin="1,0" ToolTip="{Binding Detail}">
                                                <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="70"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Count}" Foreground="#A8A4C5" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Center"/>
                                                <Border Grid.Row="1" Background="#D45CFF" Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="2,2,0,0"/>
                                                <TextBlock Grid.Row="2" Text="{Binding Label}" Foreground="#32D5FF" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding EventCounts}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <StackPanel Margin="0,0,12,8"><TextBlock Text="{Binding Name}" Foreground="{Binding Accent}"/>
                                                <TextBlock Text="{Binding Value}" FontFamily="Consolas" FontSize="23" Foreground="{Binding Accent}"/>
                                                <ProgressBar Value="{Binding FreePercent, Mode=OneWay}" Maximum="100" Height="8" Background="#2D2248" Foreground="{Binding Accent}" BorderThickness="0"/>
                                            </StackPanel>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding EventFilter, UpdateSourceTrigger=PropertyChanged}" Background="#15102D" Foreground="#E1EAF7" BorderBrush="#7944B5" Padding="8" Margin="0,4,8,10" AutomationProperties.Name="Ereignisfilter" ToolTip="Quelle, Ereignis-ID, Kanal oder Nachricht filtern"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding EventSeverity}" AutomationProperties.Name="Ereignisstufe">
                                            <ComboBoxItem Content="Alle Stufen"/><ComboBoxItem Content="Kritisch / Fehler"/><ComboBoxItem Content="Warnung"/><ComboBoxItem Content="Information"/>
                                        </ComboBox>
                                    </Grid>
                                    <DataGrid x:Name="DashboardEvents" ItemsSource="{Binding EventView}" SelectedItem="{Binding SelectedEvent, Mode=TwoWay}" Height="260" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ZEIT" Binding="{Binding LocalTime, StringFormat=MM-dd HH:mm:ss}" Width="140"/>
                                            <DataGridTextColumn Header="STUFE" Binding="{Binding Severity}" Width="110"/>
                                            <DataGridTextColumn Header="KANAL" Binding="{Binding Log}" Width="105"/>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                                            <DataGridTextColumn Header="QUELLE" Binding="{Binding Provider}" Width="2*"/>
                                            <DataGridTextColumn Header="NACHRICHT" Binding="{Binding Message}" Width="3*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="EREIGNISDETAIL / Auswahl oben / maximal 2000 Zeichen pro Nachricht" Foreground="#32D5FF" FontFamily="Consolas" Margin="0,12,0,6"/>
                                    <TextBox x:Name="DashboardEventDetail" Text="{Binding SelectedEvent.Message, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="130"
                                             VerticalScrollBarVisibility="Auto" Background="#080516" Foreground="#E1EAF7" BorderBrush="#7944B5" Padding="10" AutomationProperties.Name="Ereignisdetails"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
                                <StackPanel><Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="CPU / THERMAL" Foreground="#7F9DBA" FontSize="11"/><TextBlock Text="{Binding CpuTemperature}" FontSize="23" Margin="0,8,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding GpuIdentity}" Foreground="#FA70FF" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding GpuTemperature}" FontSize="23" Margin="0,8,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="CPU / PACKAGE POWER" Foreground="#7F9DBA" FontSize="11"/><TextBlock Text="{Binding CpuPower}" FontSize="23" Margin="0,8,0,0"/></StackPanel>
                                </Grid>
                                    <TextBlock Text="{Binding CpuSensorDetail}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <Button Content="CPU-/Sensorproviderbericht lesen" Click="SensorReportClicked" HorizontalAlignment="Left" Margin="0,8"/>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Instruments}" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Style="{StaticResource Panel}" Margin="0,0,10,8" Padding="12">
                                        <StackPanel><TextBlock Text="{Binding Name}" Foreground="#32D5FF" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="{Binding Value}" Foreground="#DCA4FF" FontFamily="Consolas" FontSize="19" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Panel}" Margin="0,0,18,0">
                                    <StackPanel>
                                        <TextBlock Text="SYSTEMPULS" FontSize="17" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding SecuritySummary}" Foreground="#8ABBD3" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                        <ItemsControl ItemsSource="{Binding Alerts}" ItemTemplate="{StaticResource CheckTemplate}"/>
                                        <TextBlock Text="Hinweise sind erklaerbar, nicht diagnostisch: Kein erfundener Health-Score, keine Lebensdauerprognose, kein Malware-Freiheitsversprechen." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Text="DATENKONTROLLE" FontSize="17" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="SensorToggle" Content="Hardware-Sensoren / beim Boot initialisiert" Checked="SensorsChanged" Unchecked="SensorsChanged"/>
                                        <TextBlock Text="{Binding SensorStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="HistoryToggle" Content="Messverlauf lokal aufzeichnen" Checked="HistoryChanged" Unchecked="HistoryChanged"/>
                                        <TextBlock Text="{Binding HistoryStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"/>
                                        <TextBlock Text="Live-Kurven: bis zu 90 Messpunkte. JSONL-Intervall konfigurierbar (Standard 5s), max. 7 Dateien / 16 MiB pro Tag. Aufzeichnung ist standardmaessig aus." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,16"/>
                                        <Button Content="Lokalen Datenordner oeffnen" Click="OpenHistoryClicked" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Mainboard" ToolTip="Virtuelles Retro-Mainboard mit lokal erkannten Komponenten und logischen Verbindungen">
                    <controls:HardwareBoardView x:Name="HardwareBoard"/>
                </TabItem>
                <TabItem Header="Taskmanager" ToolTip="Prozesse mit maschinennormiertem CPU-Anteil und Graphen fuer jeden logischen Kern">
                    <Border Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1.3*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="TASKMANAGER / EINGEBETTET / LIVE" FontFamily="Consolas" Foreground="#24FFE3" FontSize="22"/>
                            <TextBlock Text="{Binding DashboardStatus}" Foreground="{StaticResource Muted}" Margin="0,8" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" Foreground="#E1EAF7" Background="#15102D" Padding="8" ToolTip="Name / PID / Status filtern"/>
                        </StackPanel>
                        <ItemsControl Grid.Row="1" x:Name="TaskmanagerCoreOverview" ItemsSource="{Binding CoreGraphs}" ItemTemplate="{StaticResource CompactCoreTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="0,6">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CoreColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding ProcessView}" x:Name="TaskmanagerProcesses" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="80"/>
                                <DataGridTextColumn Header="CPU %" Binding="{Binding CpuDisplay}" SortMemberPath="CpuPercent" Width="100"/>
                                <DataGridTextColumn Header="RAM MB" Binding="{Binding MemoryDisplay}" SortMemberPath="MemoryMb" Width="100"/>
                                <DataGridTextColumn Header="THREADS" Binding="{Binding Threads}" Width="90"/>
                                <DataGridTextColumn Header="HANDLES" Binding="{Binding Handles}" Width="90"/>
                                <DataGridTextColumn Header="READ MB/s" Binding="{Binding ReadDisplay}" SortMemberPath="ReadMbps" Width="110"/>
                                <DataGridTextColumn Header="WRITE MB/s" Binding="{Binding WriteDisplay}" SortMemberPath="WriteMbps" Width="110"/>
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Grid.Row="3">
                            <Button Content="Auswahl / Prozessdetails" Click="ProcessDetailsClicked" Margin="0,10,8,0"/>
                            <Button Content="Prozesse / Prioritaet / Beenden" Tag="processes" Click="ManagementClicked" Margin="0,10,8,0"/>
                            <Button Content="Dienste eingebettet verwalten" Tag="services" Click="ManagementClicked" Margin="0,10,8,0"/>
                            <Button Content="Aufgaben eingebettet verwalten" Tag="tasks" Click="ManagementClicked" Margin="0,10,8,0"/>
                        </WrapPanel>
                    </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="Sensoren" ToolTip="Live-Verlaufskurven nach Hardware und Einheit; umschaltbare Detailmatrix mit Grenzwerten">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Sensor-Matrix / Live-Diagramme" FontSize="24"/>
                            <Button Content="Warnschwellen / ATX / Drosselung" Tag="Einstellungen" Click="ControlCenterNavigate" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="Springt direkt zu den Einstellungen der Systemkontrolle"/>
                            <Button Content="Sichtbare Sensoren als CSV-Snapshot" Click="ExportSensorsClicked" HorizontalAlignment="Left" ToolTip="Momentaufnahme der gefilterten Detailmatrix, inklusive gekennzeichneter Grenzwerte und leerer fehlender Werte"/>
                            <TextBlock Text="{Binding SensorStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,8"/>
                            <TextBox Text="{Binding SensorFilter, UpdateSourceTrigger=PropertyChanged}" Background="#142438" Foreground="#DCEAF7" BorderBrush="#29425C" Padding="10" ToolTip="Diagramme und Detailmatrix nach Hardware, Name, Typ, Einheit oder Sensor-ID filtern" AutomationProperties.Name="Sensorfilter"/>
                        </StackPanel>
                        <controls:SensorChartsView x:Name="SensorCharts" Grid.Row="1"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Laufwerke" ToolTip="Windows Storage Health und Speicherplatz; vollstaendiges SMART im Modul SMART der Systemkontrolle">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Storage Observatory" FontSize="24"/>
                            <Button Content="SMART-Diagnose und Laufwerkstests" Tag="SMART" Click="ControlCenterNavigate" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="Springt direkt zum SMART-Modul der Systemkontrolle"/>
                            <TextBlock Text="Windows Storage Health und freier Speicher. Vollstaendiges NVMe-SMART und herstellerspezifische Diagnosen sind damit nicht garantiert; fehlende Detailwerte bleiben sichtbar." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,18"/>
                            <TextBlock Text="PHYSISCHE LAUFWERKE" Foreground="#5DE5D0" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding Disks}" ItemTemplate="{StaticResource CheckTemplate}"/>
                            <TextBlock Text="VOLUMES / SPEICHERPLATZ" Foreground="#5DE5D0" Margin="0,18,0,12"/>
                            <ItemsControl ItemsSource="{Binding Volumes}" ItemTemplate="{StaticResource CheckTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Messauswertung" ToolTip="MIN/MAX/AVG-Statistik, JSONL-Aufzeichnung, Logvergleich und CSV-Export">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Messauswertung / MIN - MAX - AVG" FontSize="24" Foreground="#24FFE3" FontFamily="Consolas"/>
                            <Button Content="Log-Viewer / Gaming / Vergleich" Click="OpenControlCenterClicked" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding SessionStatus}" Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
                            <WrapPanel>
                                <Button Content="Neue Messsitzung" Click="ResetStatisticsClicked" Margin="0,0,12,0"/>
                                <Button Content="Sitzung anhalten / fortsetzen" Click="PauseStatisticsClicked" Margin="0,0,12,0"/>
                                <Button Content="Sichtbare Auswertung als CSV exportieren" Click="ExportStatisticsClicked"/>
                            </WrapPanel>
                            <TextBlock Text="Sitzungsstatistik im RAM, keine FPS-Messung und kein synthetischer Benchmark. Sensorluecken werden nicht als 0 gemittelt." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <TextBox Text="{Binding StatisticsFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBox}" AutomationProperties.Name="Statistikfilter" ToolTip="Hardware, Messreihe oder Einheit filtern; CSV exportiert nur sichtbare Reihen" Margin="0,8"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding StatisticsView}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="KOMPONENTE" Binding="{Binding Hardware}" Width="2*"/>
                                <DataGridTextColumn Header="MESSREIHE" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="MIN" Binding="{Binding MinDisplay}" Width="*"/>
                                <DataGridTextColumn Header="MAX" Binding="{Binding MaxDisplay}" Width="*"/>
                                <DataGridTextColumn Header="AVG" Binding="{Binding AvgDisplay}" Width="*"/>
                                <DataGridTextColumn Header="PUNKTE" Binding="{Binding Count}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="Diagnose" ToolTip="Lesende Windows-Pruefungen, Speicherdiagnose-Ergebnisse, Diagnose-Export und Schnellzugriffe">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Diagnose &amp; Systemkontrolle" FontSize="24" Foreground="#32D5FF" FontFamily="Consolas"/>
                            <WrapPanel Margin="0,12,0,12">
                                <Button Content="Windows-Diagnose &amp; Problemlösung" Click="OpenWindowsAssistantsClicked" Margin="0,0,8,0" ToolTip="Oeffnet die getrennten Windows-Assistenten fuer Systemdateien, Updates, Netzwerk und Geraete/Treiber"/>
                                <Button Content="Erweiterte Systemkontrolle" Click="OpenControlCenterClicked" Margin="0,0,8,0" ToolTip="SMART, Pakete, Netzwerk, Wartungskatalog, Spuren, Einstellungen und Schluessel"/>
                                <Button Content="Speicherdiagnose-Ergebnisse" Click="MemoryDiagnosticsClicked" Margin="0,0,8,0" ToolTip="Vorhandene Ergebnisse der Windows-Speicherdiagnose aus dem System-Ereignislog lesen; startet keinen RAM-Test"/>
                                <Button Content="Diagnosebericht exportieren" Click="ExportDiagnosticsClicked" ToolTip="Textbericht mit Vorschau; persoenliche Angaben werden auf Wunsch geschwaerzt"/>
                                <Button Content="Rechner-Inventar" Click="InventoryClicked" ToolTip="Lokales Inventar aus Hardware und installierter Software anzeigen und speichern"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding ProbeStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="WINDOWS / DIREKTE WERKZEUGE" Foreground="#D45CFF" FontFamily="Consolas" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button Content="Task-Manager" Tag="taskmgr" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="Geraete-Manager" Tag="devices" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="Datentraegerverwaltung" Tag="disks" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="Ereignisanzeige" Tag="events" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="Windows Sicherheit" Tag="security" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="Autostart verwalten" Tag="startup" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="Windows Update" Tag="updates" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="Netzwerk / WLAN" Tag="network" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="Aufgabenplanung" Tag="tasks" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="Dienste" Tag="services" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="GodMode-Ordner" Tag="godmode" Click="OpenToolClicked" Margin="0,0,8,8"
                                                ToolTip="Windows-Ansicht 'Alle Aufgaben'. Auf Windows-Builds ohne diese Ansicht oeffnet sich stattdessen Alle Systemsteuerungselemente - mit Hinweis in der Fusszeile."/>
                                        <Button Content="AETHER xBar AN/AUS" Tag="xbar" Click="OpenToolClicked" Margin="0,0,8,8"
                                                ToolTip="App-, Datei-, Ordner- und Laufwerkszugriff, Live-Widgets und bestaetigungspflichtige Windows-Aktionen"/>
                                    </WrapPanel>
                                    <TextBlock Text="Oeffnet die originalen Windows-Werkzeuge. Aenderungen dort erfolgen unter deiner Kontrolle. Keine Hintergrund-Reparaturen, keine Schutzabschaltung." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Diagnostics}" ItemTemplate="{StaticResource CheckTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Sicherheit" ToolTip="Lesender Schutzstatus: Defender, Firewall, BitLocker, Secure Boot, TPM, Updates">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Sicherheit &amp; Windows-Telemetrie" FontSize="24"/>
                            <TextBlock Text="{Binding ProbeStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,10"/>
                            <TextBlock Text="Gruen: gemeldete Pruefung bestanden. Orange: Hinweis. Grau: Information oder unbekannt. Nicht lesbar bedeutet niemals sicher. Diese Ansicht ersetzt kein Sicherheitsprodukt." Foreground="#8ABBD3" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource CheckTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Cleaner" ToolTip="Vorschau mit Bewertung, explizite Checkbox-Auswahl, endgueltiges Loeschen nur nach Bestaetigung">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Cleaner / Vorschau vor Kontrolle" FontSize="24" Foreground="#D45CFF" FontFamily="Consolas"/>
                            <TextBlock Text="Nur gewaehlte Kategorie, Dateien aelter als 7 Tage. Keine Downloads, Cookies, Lesezeichen oder Offline-Medien. Keine Ordnerloeschung. System-/Diagnosecaches nur bewusst im Expertenmodus." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                            <WrapPanel IsEnabled="{Binding CanClean}" Margin="0,0,0,12">
                                <ComboBox x:Name="CacheLevel" Width="180" SelectedIndex="0" SelectionChanged="CacheLevelChanged" Margin="0,0,12,0">
                                    <ComboBoxItem Content="Schnell"/><ComboBoxItem Content="Standard"/><ComboBoxItem Content="Tief"/><ComboBoxItem Content="Experte"/>
                                </ComboBox>
                                <ComboBox x:Name="CacheTargets" Width="520" SelectionChanged="CacheTargetChanged" AutomationProperties.Name="Cache-Kategorie"/>
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="Grosse Dateien finden / nur lesen" Click="StorageAnalysisClicked" Margin="0,0,12,0"/>
                                <Button Content="Temp-Dateien pruefen" Click="ScanCleanupClicked" IsEnabled="{Binding CanClean}" Margin="0,0,12,0"/>
                                <Button Content="Sichtbare ankreuzen" Tag="visible" Click="CleanupSelectionClicked" IsEnabled="{Binding CanClean}" Margin="0,0,8,0"/>
                                <Button Content="Keine ankreuzen" Tag="none" Click="CleanupSelectionClicked" IsEnabled="{Binding CanClean}" Margin="0,0,8,0"/>
                                <Button Content="Markierte Zeilen ankreuzen" Tag="rows" Click="CleanupSelectionClicked" IsEnabled="{Binding CanClean}" Margin="0,0,8,0"/>
                                <Button Content="Angekreuzte Dateien loeschen" Click="DeleteCleanupClicked" IsEnabled="{Binding CanClean}" BorderBrush="#FF354A" Margin="0,0,12,0"/>
                                <Button Content="Abbrechen" Click="CancelCleanupClicked"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding CleanupStatus}" Foreground="#32D5FF" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <TextBlock x:Name="CleanupSelectionStatus" Text="0 Dateien angekreuzt / 0 MiB. Zeilenmarkierung loescht nichts." Foreground="#39FF68" TextWrapping="Wrap" Margin="0,5"/>
                            <TextBox Text="{Binding CleanupFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBox}" AutomationProperties.Name="Cleaner-Pfadfilter" ToolTip="Nur Ansicht filtern. Versteckte angekreuzte Dateien bleiben ausgewaehlt; Keine ankreuzen leert die gesamte Auswahl." Margin="0,8"/>
                        </StackPanel>
                        <DataGrid x:Name="CleanupGrid" Grid.Row="1" ItemsSource="{Binding CleanupView}" SelectionMode="Extended" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="LOESCHEN?" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.CanClean, RelativeSource={RelativeSource AncestorType=DataGrid}}" Checked="CleanupChecked" Unchecked="CleanupChecked" HorizontalAlignment="Center" ToolTip="Nur angekreuzte Dateien werden nach Bestaetigung geloescht"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="GEPRUEFTE DATEI / ZEILENMARKIERUNG IST KEINE LOESCHFREIGABE" Binding="{Binding Path}" Width="4*"/>
                                <DataGridTextColumn Header="GROESSE" Binding="{Binding SizeDisplay}" Width="*"/>
                                <DataGridTextColumn Header="GEAENDERT (UTC)" Binding="{Binding LastWriteUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="Ereignisse" ToolTip="Windows-Ereignisprotokolle: Kanal und Zeitraum waehlen, Details eingebettet lesen"><Border Style="{StaticResource Panel}"><controls:EventBrowser x:Name="EmbeddedEvents"/></Border></TabItem>
                <TabItem Header="Superadmin" ToolTip="Statusbasierte Verwaltung: Dienste, Aufgaben, Firewall, Pakete, Benutzer - mit Vorschau, Einzelbestaetigung und Ruecknahme"><Border Style="{StaticResource Panel}"><controls:AdminWorkbench x:Name="Workbench"/></Border></TabItem>
                <TabItem Header="Operations" ToolTip="Wartungsplaene, Windows-Updates und Arbeitsgruppen-Geraete - einzeln bestaetigt und protokolliert"><Border Style="{StaticResource Panel}"><controls:OperationsHub x:Name="Operations"/></Border></TabItem>
                <TabItem Header="Hilfe" ToolTip="Durchsuchbare Anleitung: Schritt-fuer-Schritt je Modul, Sicherheitsregeln und Grenzen">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Hilfe-Center" FontSize="24"/>
                            <TextBlock Text="Lokale, durchsuchbare Hilfe zu jedem Modul: was es tut, wie du es Schritt fuer Schritt benutzt und wo die Grenzen liegen. Keine Online-Verbindung, keine Telemetrie." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,10"/>
                            <TextBox x:Name="HelpSearch" TextChanged="HelpSearchChanged" Background="#142438" Foreground="#DCEAF7" BorderBrush="#29425C" Padding="10" ToolTip="Thema, Modul oder Stichwort suchen, z.B. 'Update', 'Temperatur', 'Loeschen'" AutomationProperties.Name="Hilfesuche"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ListBox x:Name="HelpList" Background="#15102D" Foreground="#E1EAF7" BorderBrush="#29425C" SelectionChanged="HelpSelected" AutomationProperties.Name="Hilfethemen" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <StackPanel Margin="3">
                                        <TextBlock Text="{Binding Module}" Foreground="#D45CFF" FontSize="11"/>
                                        <TextBlock Text="{Binding Title}" Foreground="#24FFE3" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="14,0,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock x:Name="HelpTitle" FontSize="19" Foreground="#24FFE3" Text="Thema links auswaehlen." TextWrapping="Wrap"/>
                                        <TextBlock x:Name="HelpBody" Foreground="#DCEAF7" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="14" LineHeight="22"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
            <Border Grid.Row="3" BorderBrush="#203047" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
                <TextBlock Text="{Binding Footer}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>
