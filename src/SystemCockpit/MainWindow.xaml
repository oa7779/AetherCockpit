<Window x:Class="SystemCockpit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SystemCockpit.Controls"
        xmlns:loc="clr-namespace:SystemCockpit.Services"
        Title="AETHER | System Observatory | Olaf Weins" Width="1440" Height="940" MinWidth="1060" MinHeight="680"
        Background="{DynamicResource WindowBackdrop}" Foreground="#E1EAF7" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" Icon="Assets/aether.ico">
    <Window.Resources>
        <ResourceDictionary>
        <SolidColorBrush x:Key="Muted" Color="#A8A4C5"/>
        <DrawingBrush x:Key="ConsoleGrid" TileMode="Tile" Viewport="0,0,36,36" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{DynamicResource SceneBackdrop}">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,36,36"/></GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen><Pen Brush="#171127" Thickness="0.5"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E1EAF7"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource NeonButton}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource NeonCheckBox}">
            <Setter Property="Foreground" Value="#CFDCEE"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="controls:FrameGlow.Visible" Value="True"/>
            <Setter Property="controls:FrameGlow.Enabled" Value="{Binding DataContext.MotionEnabled, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Background" Value="{DynamicResource GlossPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassRim}"/>
            <Setter Property="BorderThickness" Value="2,1,1,2"/>
            <Setter Property="CornerRadius" Value="22,5,22,5"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource NeonDataGrid}"/>
        <DataTemplate x:Key="CheckTemplate">
            <Border Background="#15102D" CornerRadius="12,2,12,2" Padding="14" Margin="0,0,0,9" BorderBrush="#352451" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{Binding Accent}" CornerRadius="2"/>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{Binding Name}" Foreground="#9EB3CC" FontSize="12"/>
                        <TextBlock Text="{Binding Value}" Foreground="{Binding Accent}" FontSize="15" Margin="0,4,0,4" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DashboardGraphTemplate">
            <Border Tag="chart-panel" Background="{DynamicResource GlossPanel}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" CornerRadius="10,2,10,2" Margin="0,0,8,8" Padding="10">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                    <DockPanel Margin="0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Foreground="{Binding Accent}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/><controls:LedDisplay Text="{Binding NumericValue}" Accent="{Binding Accent}" Height="30" HorizontalAlignment="Left" Width="128"/></DockPanel>
                    <Viewbox Height="45" Stretch="Fill">
                        <Canvas Tag="chart-canvas" Width="280" Height="56" Background="#0A0717">
                            <Line X1="0" Y1="28" X2="280" Y2="28" Stroke="#2D2248"/>
                            <Line X1="0" Y1="56" X2="280" Y2="56" Stroke="#2D2248"/>
                            <Polyline Points="{Binding Trace}" Stroke="{Binding Accent}" StrokeThickness="7" Opacity="0.12"/>
                            <Polyline Points="{Binding Trace}" Stroke="{Binding Accent}" StrokeThickness="4" Opacity="0.3"/>
                            <Polyline Points="{Binding Trace}" Stroke="{Binding Accent}" StrokeThickness="2"/>
                        </Canvas>
                    </Viewbox>
                    <ProgressBar Value="{Binding Level, Mode=OneWay}" Maximum="100" Height="6" Background="#2D2248" Foreground="{Binding Accent}" BorderThickness="0" Margin="0,5"/>
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CompactCoreTemplate">
            <Border Tag="chart-panel" Background="#090511" BorderBrush="#19A991" BorderThickness="1" Margin="2" Padding="4" CornerRadius="5">
                <Grid ToolTip="{Binding Detail}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/></Grid.RowDefinitions>
                    <DockPanel>
                        <controls:LedDisplay DockPanel.Dock="Right" Text="{Binding NumericValue}" Accent="#39FF68" Width="72" Height="24"/>
                        <TextBlock Text="{Binding Title}" Foreground="#24FFE3" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <Viewbox Grid.Row="1" Stretch="Fill" Margin="0,3">
                        <Canvas Tag="chart-canvas" Width="180" Height="56" Background="#071711">
                            <Line X1="0" X2="180" Y1="28" Y2="28" Stroke="#19432B"/>
                            <Polyline Points="{Binding Trace}" Stroke="#39FF68" StrokeThickness="7" Opacity="0.12"><Polyline.RenderTransform><ScaleTransform ScaleX="0.643"/></Polyline.RenderTransform></Polyline>
                            <Polyline Points="{Binding Trace}" Stroke="#39FF68" StrokeThickness="4" Opacity="0.3"><Polyline.RenderTransform><ScaleTransform ScaleX="0.643"/></Polyline.RenderTransform></Polyline>
                            <Polyline Points="{Binding Trace}" Stroke="#39FF68" StrokeThickness="2" RenderTransformOrigin="0,0"><Polyline.RenderTransform><ScaleTransform ScaleX="0.643"/></Polyline.RenderTransform></Polyline>
                        </Canvas>
                    </Viewbox>
                    <ProgressBar Grid.Row="2" Value="{Binding Level, Mode=OneWay}" Maximum="100" Foreground="#39FF68" Background="#183426" BorderThickness="0"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CompactDiskTemplate">
            <Border Tag="chart-panel" Background="#120711" BorderBrush="#FF576E" BorderThickness="1" Margin="3" Padding="8" Height="92" CornerRadius="6">
                <Grid ToolTip="{Binding Detail}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="6"/></Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Foreground="#24FFE3" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <controls:LedDisplay DockPanel.Dock="Right" Text="{Binding NumericValue}" Accent="#FF354A" Width="96" Height="28"/>
                        <TextBlock Text="{Binding Title}" Foreground="#FF576E" FontFamily="Consolas" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Viewbox Grid.Row="1" Stretch="Fill" Margin="0,4"><Canvas Tag="chart-canvas" Width="280" Height="56" Background="#08060C">
                        <Line X1="0" X2="280" Y1="28" Y2="28" Stroke="#392027"/>
                        <Polyline Points="{Binding Trace}" Stroke="#FF354A" StrokeThickness="7" Opacity="0.12"/>
                        <Polyline Points="{Binding Trace}" Stroke="#FF354A" StrokeThickness="4" Opacity="0.3"/>
                        <Polyline Points="{Binding Trace}" Stroke="#FF354A" StrokeThickness="2"/>
                    </Canvas></Viewbox>
                    <ProgressBar Grid.Row="2" Value="{Binding Level, Mode=OneWay}" Maximum="100" Foreground="#FF354A" Background="#391321" BorderThickness="0"/>
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="ShellNeonFrame" Margin="6" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" CornerRadius="12"
            controls:FrameGlow.Visible="True" controls:FrameGlow.Enabled="{Binding MotionEnabled}">
    <Grid Background="{StaticResource ConsoleGrid}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource ChromeSidebar}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="0,0,3,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,30,20,20">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource NeonButton}">
                        <Setter Property="Padding" Value="8,8"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                </StackPanel.Resources>
                <StackPanel DockPanel.Dock="Top">
                    <Image x:Name="DashboardLogo" Source="/SystemCockpit;component/Assets/aether-logo.png"
                           Height="112" Stretch="Uniform" Margin="0,0,0,10"/>
                    <TextBlock Text="A E T H E R" Foreground="#24FFE3" FontFamily="Consolas" FontSize="25" FontWeight="Bold">
                        <TextBlock.Effect><DropShadowEffect Color="#24FFE3" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/></TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="NeonDesignTagline" Text="NEON WAVE / GLASS CONTROL" Foreground="#F56AFF" FontFamily="Consolas" FontSize="10" Margin="0,8,0,14"/>
                    <Border Background="#D45CFF" Height="12" CornerRadius="6,0,0,6" Margin="0,0,0,5"/>
                    <Border Background="#4294FF" Height="7" CornerRadius="4,0,0,4" Margin="22,0,0,18"/>
                    <TextBlock Text="{loc:DesktopLabel Main.Areas}" FontFamily="Consolas" FontSize="10" Foreground="#32D5FF" Margin="0,0,0,12"/>
                    <Button Content="{loc:DesktopLabel Main.Find}" Click="TaskCenterClicked" HorizontalContentAlignment="Left" Margin="0,0,0,12" ToolTip="{loc:DesktopLabel Main.FindTip}"/>
                    <StackPanel x:Name="NavigationGroups"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Button Content="{loc:DesktopLabel Main.Desktop}" Click="DisplaySettingsClicked" HorizontalContentAlignment="Left"
                            ToolTip="{loc:DesktopLabel Main.DesktopTip}"/>
                    <CheckBox Content="{loc:DesktopLabel Main.Motion, ModernKey=Main.ModernMotion}" ToolTip="{loc:DesktopLabel Main.MotionTip, ModernKey=Main.ModernMotionTip}" IsChecked="{Binding MotionEnabled}"/>
                    <TextBlock Text="{Binding AccessStatus}" Foreground="#32D5FF" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,6,0,8"/>
                    <TextBlock Text="{loc:DesktopLabel Main.Admin}" Foreground="#24FFE3" FontSize="11" Margin="0,0,0,14"/>
                    <Border BorderBrush="#6940A8" BorderThickness="1" CornerRadius="16,3,16,3" Padding="12">
                        <StackPanel>
                            <TextBlock Text="LOCAL FIRST" Foreground="#5DE5D0" FontSize="11"/>
                            <TextBlock Text="{loc:DesktopLabel Main.LocalNotice}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="NATIVE / WINDOWS / v0.7" Foreground="#A8A4C5" FontFamily="Consolas" FontSize="10" Margin="0,16,0,0"/>
                    <TextBlock Text="Copyright (c) 2026 Olaf Weins" TextWrapping="Wrap" Foreground="#32D5FF" FontFamily="Consolas" FontSize="10" Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Column="1" Margin="28,12,28,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:DesktopLabel Main.Tagline}" Foreground="#24FFE3" FontFamily="Consolas" FontSize="11"/>
                    <TextBlock Text="System Observatory" Foreground="#DCA4FF" FontFamily="Consolas" FontSize="30" FontWeight="Bold" Margin="0,5,0,5"/>
                    <TextBlock Text="{Binding SystemIdentity}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <controls:LedDisplay Text="{Binding SystemClock}" Accent="#FF354A" Width="180" Height="32" ToolTip="{loc:DesktopLabel Main.ClockTip}"/>
                    <TextBlock Text="{Binding SystemUptime}" Foreground="#F56AFF" FontFamily="Consolas" HorizontalAlignment="Right" Margin="0,2,0,4"/>
                    <TextBlock Text="{Binding LiveStatus}" Foreground="#24FFE3" FontFamily="Consolas" HorizontalAlignment="Right" Margin="0,2,0,8"/>
                    <Button Content="{loc:DesktopLabel Main.Refresh}" Click="RefreshClicked" IsEnabled="{Binding CanRefresh}"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" BorderBrush="#6940A8" BorderThickness="1" CornerRadius="8" Background="#140E2C" Padding="8,3" Margin="0,0,0,8">
                <DockPanel>
                    <Button x:Name="NavBack" Content="{loc:DesktopLabel Navigation.BackButton}" Click="NavBackClicked" IsEnabled="False" Margin="0,0,8,0" Padding="8,3" FontSize="11"
                            ToolTip="{loc:DesktopLabel Navigation.BackTip}"/>
                    <Button x:Name="NavForward" Content="{loc:DesktopLabel Navigation.ForwardButton}" Click="NavForwardClicked" IsEnabled="False" Margin="0,0,8,0" Padding="8,3" FontSize="11"
                            ToolTip="{loc:DesktopLabel Navigation.ForwardTip}"/>
                    <Button Content="&#8962; COCKPIT" Click="NavHomeClicked" Margin="0,0,8,0" Padding="8,3" FontSize="11"
                            ToolTip="{loc:DesktopLabel Navigation.CockpitTip}"/>
                    <Button Content="{loc:DesktopLabel Navigation.HelpButton}" Click="NavHelpClicked" DockPanel.Dock="Right" Padding="8,3" FontSize="11"
                            ToolTip="{loc:DesktopLabel Navigation.HelpTip}"/>
                    <TextBlock x:Name="NavTrail" Text="{loc:DesktopLabel Navigation.InitialTrail}" Foreground="#24FFE3" FontFamily="Consolas" FontSize="12"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               ToolTip="{loc:DesktopLabel Navigation.TrailTip}"/>
                </DockPanel>
            </Border>
            <TabControl x:Name="Pages" Grid.Row="2" SelectionChanged="PageChanged" Background="Transparent" Foreground="#E1EAF7" BorderThickness="0" Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style>
                </TabControl.Resources>
                <TabItem Header="Cockpit" Tag="Cockpit" ToolTip="{loc:DesktopLabel Module.CockpitTip}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="CPU // MEMORY // STORAGE // LIVE" Foreground="#39FF68" FontFamily="Consolas" FontSize="18"/>
                                    <TextBlock Text="{Binding CpuIdentity}" Foreground="#24FFE3" TextWrapping="Wrap" Margin="0,4"/>
                                    <TextBlock Text="{Binding MemoryIdentity}" Foreground="#FD59FF" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border BorderBrush="#39FF68" BorderThickness="1" CornerRadius="8" Background="#07110E" Margin="0,0,8,8">
                                            <Grid DataContext="{Binding Cards[0]}">
                                                <controls:NeonGauge Level="{Binding Level}" Accent="#39FF68"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:DesktopLabel Main.CpuTotal}" Foreground="#39FF68" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center"/>
                                                    <controls:LedDisplay Text="{Binding Value}" Accent="#39FF68" Height="36" Width="120" Margin="0,4"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding DetailGraphs}" ItemTemplate="{StaticResource DashboardGraphTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    </Grid>
                                    <WrapPanel><TextBlock Text="{loc:DesktopLabel Main.CpuTemperature}" Foreground="#FFCE54"/><TextBlock Text="{Binding CpuTemperature}" Foreground="#39FF68"/><TextBlock Text="{loc:DesktopLabel Main.PackagePower}" Foreground="#FFCE54"/><TextBlock Text="{Binding CpuPower}" Foreground="#39FF68"/></WrapPanel>
                                    <TextBlock Text="{loc:DesktopLabel Main.CpuCores}" Foreground="#24FFE3" FontFamily="Consolas" Margin="0,6"/>
                                    <ItemsControl x:Name="CockpitCoreOverview" ItemsSource="{Binding CoreGraphs}" ItemTemplate="{StaticResource CompactCoreTemplate}" Height="288">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CoreColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Text="{loc:DesktopLabel Main.PhysicalDisks}" Foreground="#FF576E" FontFamily="Consolas" Margin="0,8"/>
                                    <ItemsControl ItemsSource="{Binding DiskGraphs}" ItemTemplate="{StaticResource CompactDiskTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Background="#140D29" BorderBrush="#7842C6" BorderThickness="1" CornerRadius="18,2,18,2" Padding="12,6" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="A-01 // SYSTEM BUS" Foreground="#D45CFF" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    <Viewbox Grid.Column="1" Height="18" Stretch="Fill" Margin="18,0">
                                        <Canvas Width="480" Height="18" ClipToBounds="True">
                                            <Rectangle Width="480" Height="18" Fill="#251639"/>
                                            <Rectangle x:Name="Scanner" Width="70" Height="18" RadiusX="3" Fill="#24FFE3">
                                                <Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform>
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding MotionEnabled}" Value="True"/>
                                                                    <Condition Binding="{Binding Path=(controls:FrameGlow.MotionActive), ElementName=ShellNeonFrame}" Value="True"/>
                                                                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="ScannerMotion">
                                                                        <Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="410" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="ScannerMotion"/></MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Grid.Column="2" Text="{loc:DesktopLabel Layout.VisualScanner}" Foreground="#32D5FF" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="MetricCards" ItemsSource="{Binding Cards}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Panel}" BorderBrush="{Binding Accent}" Margin="0,0,10,18" Padding="16">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}" FontSize="11" FontWeight="SemiBold"/>
                                                <Grid Height="150" Margin="0,6,0,8">
                                                    <controls:NeonGauge Level="{Binding Level}" Accent="{Binding Accent}"/>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <controls:LedDisplay Text="{Binding Value}" Accent="{Binding Accent}" Width="125" Height="38"/>
                                                        <TextBlock Text="{Binding Unit}" Foreground="{Binding Accent}" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" MinHeight="34"/>
                                                <Viewbox Height="56" Stretch="Fill" Margin="0,15,0,12">
                                                    <Canvas Width="280" Height="56">
                                                        <Line X1="0" Y1="56" X2="280" Y2="56" Stroke="#233A50"/>
                                                        <Polyline Points="{Binding Trace}" Stroke="{Binding Accent}" StrokeThickness="2"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Level}" Height="7" Foreground="{Binding Accent}" Background="#2D2248" BorderThickness="0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="TASKMANAGER / LIVE PERFORMANCE" Foreground="#24FFE3" FontFamily="Consolas" FontSize="19"/>
                                    <TextBlock Text="{Binding DashboardStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8"/>
                                    <Expander Header="{loc:DesktopLabel Ui.NetworkHeading}" Foreground="#32D5FF" Margin="0,8">
                                        <ItemsControl ItemsSource="{Binding AdapterGraphs}" ItemTemplate="{StaticResource DashboardGraphTemplate}" Margin="0,10">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Expander>
                                    <Expander Header="{loc:DesktopLabel Layout.VolumeHistory}" Foreground="#4294FF" Margin="0,8" IsExpanded="True">
                                        <ItemsControl ItemsSource="{Binding VolumeGraphs}" ItemTemplate="{StaticResource DashboardGraphTemplate}" Margin="0,10">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Expander>
                                    <Expander Header="{loc:DesktopLabel Ui.SensorsHeading}" Foreground="#D45CFF" Margin="0,8">
                                        <StackPanel>
                                            <TextBlock Text="{loc:DesktopLabel Layout.SensorAccessNotice}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8"/>
                                            <ItemsControl ItemsSource="{Binding SensorGraphs}" ItemTemplate="{StaticResource DashboardGraphTemplate}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{loc:DesktopLabel Ui.ProcessMonitorHeading}" FontFamily="Consolas" Foreground="#24FFE3" FontSize="19"/>
                                    <TextBlock Text="{loc:DesktopLabel Layout.ProcessAccounting}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8"/>
                                    <TextBox Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" Background="#15102D" Foreground="#E1EAF7" BorderBrush="#7944B5" Padding="8" Margin="0,0,0,8" AutomationProperties.Name="{loc:DesktopLabel Ui.ProcessFilter}" ToolTip="{loc:DesktopLabel Ui.ProcessFilterTipAlt}"/>
                                    <DataGrid x:Name="DashboardProcesses" ItemsSource="{Binding ProcessView}" Height="330" EnableRowVirtualization="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{loc:DesktopLabel Ui.ProcessColumn}" Binding="{Binding Name}" Width="2*"/>
                                            <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="75"/>
                                            <DataGridTemplateColumn Header="CPU %" SortMemberPath="CpuPercent" Width="110">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid>
                                                    <ProgressBar Value="{Binding CpuLevel, Mode=OneWay}" Maximum="100" Foreground="#225C59" Background="#15102D" BorderThickness="0"/>
                                                    <TextBlock Text="{Binding CpuDisplay}" Foreground="#24FFE3" VerticalAlignment="Center" Margin="5,0"/>
                                                </Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="RAM MB" SortMemberPath="MemoryMb" Width="100">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid>
                                                    <ProgressBar Value="{Binding MemoryMb, Mode=OneWay, TargetNullValue=0}" Maximum="{Binding DataContext.PhysicalMemoryMb, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                                                 Foreground="#253B67" Background="#15102D" BorderThickness="0"/>
                                                    <TextBlock Text="{Binding MemoryDisplay}" Foreground="#9DBDFF" VerticalAlignment="Center" Margin="5,0"/>
                                                </Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="THREADS" Binding="{Binding Threads}" Width="85"/>
                                            <DataGridTextColumn Header="HANDLES" Binding="{Binding Handles}" Width="90"/>
                                            <DataGridTextColumn Header="READ MB/s" Binding="{Binding ReadDisplay}" SortMemberPath="ReadMbps" Width="105"/>
                                            <DataGridTextColumn Header="WRITE MB/s" Binding="{Binding WriteDisplay}" SortMemberPath="WriteMbps" Width="110"/>
                                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="220"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="EVENTMONITOR / SYSTEM + APPLICATION" FontFamily="Consolas" Foreground="#D45CFF" FontSize="19"/>
                                    <TextBlock Text="{Binding EventStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8"/>
                                    <TextBlock Text="{loc:DesktopLabel Layout.EventBuckets}" Foreground="#32D5FF" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding EventBuckets}" Height="115" Margin="0,0,0,12">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="24"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid Margin="1,0" ToolTip="{Binding Detail}">
                                                <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="70"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Count}" Foreground="#A8A4C5" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Center"/>
                                                <Border Grid.Row="1" Background="#D45CFF" Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="2,2,0,0"/>
                                                <TextBlock Grid.Row="2" Text="{Binding Label}" Foreground="#32D5FF" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding EventCounts}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <StackPanel Margin="0,0,12,8"><TextBlock Text="{Binding Name}" Foreground="{Binding Accent}"/>
                                                <TextBlock Text="{Binding Value}" FontFamily="Consolas" FontSize="23" Foreground="{Binding Accent}"/>
                                                <ProgressBar Value="{Binding FreePercent, Mode=OneWay}" Maximum="100" Height="8" Background="#2D2248" Foreground="{Binding Accent}" BorderThickness="0"/>
                                            </StackPanel>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding EventFilter, UpdateSourceTrigger=PropertyChanged}" Background="#15102D" Foreground="#E1EAF7" BorderBrush="#7944B5" Padding="8" Margin="0,4,8,10" AutomationProperties.Name="{loc:DesktopLabel Ui.EventFilter}" ToolTip="{loc:DesktopLabel Layout.EventFilter}"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding EventSeverity}" AutomationProperties.Name="{loc:DesktopLabel Ui.EventLevel}">
                                            <ComboBoxItem Content="{loc:DesktopLabel Ui.AllLevels}"/><ComboBoxItem Content="{loc:DesktopLabel Layout.CriticalErrors}"/><ComboBoxItem Content="{loc:DesktopLabel Ui.Warning}"/><ComboBoxItem Content="Information"/>
                                        </ComboBox>
                                    </Grid>
                                    <DataGrid x:Name="DashboardEvents" ItemsSource="{Binding EventView}" SelectedItem="{Binding SelectedEvent, Mode=TwoWay}" Height="260" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{loc:DesktopLabel Layout.Time}" Binding="{Binding LocalTime, StringFormat=MM-dd HH:mm:ss}" Width="140"/>
                                            <DataGridTextColumn Header="{loc:DesktopLabel Ui.LevelColumn}" Binding="{Binding Severity}" Width="110"/>
                                            <DataGridTextColumn Header="{loc:DesktopLabel Ui.ChannelColumn}" Binding="{Binding Log}" Width="105"/>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                                            <DataGridTextColumn Header="{loc:DesktopLabel Layout.Source}" Binding="{Binding Provider}" Width="2*"/>
                                            <DataGridTextColumn Header="{loc:DesktopLabel Ui.MessageColumn}" Binding="{Binding Message}" Width="3*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="{loc:DesktopLabel Layout.EventDetailNotice}" Foreground="#32D5FF" FontFamily="Consolas" Margin="0,12,0,6"/>
                                    <TextBox x:Name="DashboardEventDetail" Text="{Binding SelectedEvent.Message, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="130"
                                             VerticalScrollBarVisibility="Auto" Background="#080516" Foreground="#E1EAF7" BorderBrush="#7944B5" Padding="10" AutomationProperties.Name="{loc:DesktopLabel Ui.EventDetails}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
                                <StackPanel><Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="CPU / THERMAL" Foreground="#7F9DBA" FontSize="11"/><TextBlock Text="{Binding CpuTemperature}" FontSize="23" Margin="0,8,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding GpuIdentity}" Foreground="#FA70FF" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding GpuTemperature}" FontSize="23" Margin="0,8,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="CPU / PACKAGE POWER" Foreground="#7F9DBA" FontSize="11"/><TextBlock Text="{Binding CpuPower}" FontSize="23" Margin="0,8,0,0"/></StackPanel>
                                </Grid>
                                    <TextBlock Text="{Binding CpuSensorDetail}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <Button Content="{loc:DesktopLabel Layout.ReadSensorReport}" Click="SensorReportClicked" HorizontalAlignment="Left" Margin="0,8"/>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Instruments}" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Style="{StaticResource Panel}" Margin="0,0,10,8" Padding="12">
                                        <StackPanel><TextBlock Text="{Binding Name}" Foreground="#32D5FF" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="{Binding Value}" Foreground="#DCA4FF" FontFamily="Consolas" FontSize="19" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Panel}" Margin="0,0,18,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:DesktopLabel Ui.SystemPulse}" FontSize="17" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding SecuritySummary}" Foreground="#8ABBD3" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                        <ItemsControl ItemsSource="{Binding Alerts}" ItemTemplate="{StaticResource CheckTemplate}"/>
                                        <TextBlock Text="{loc:DesktopLabel Layout.HealthNotice}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:DesktopLabel Ui.DataControl}" FontSize="17" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="SensorToggle" Content="{loc:DesktopLabel Ui.SensorBoot}" Checked="SensorsChanged" Unchecked="SensorsChanged"/>
                                        <TextBlock Text="{Binding SensorStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="HistoryToggle" Content="{loc:DesktopLabel Layout.RecordHistory}" Checked="HistoryChanged" Unchecked="HistoryChanged"/>
                                        <TextBlock Text="{Binding HistoryStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"/>
                                        <TextBlock Text="{loc:DesktopLabel Ui.HistoryNotice}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,16"/>
                                        <Button Content="{loc:DesktopLabel Layout.OpenDataFolder}" Click="OpenHistoryClicked" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{loc:DesktopLabel Module.Mainboard, ModernKey=Module.SystemSchema}" Tag="Mainboard" ToolTip="{loc:DesktopLabel Module.BoardTip, ModernKey=Module.SchemaTip}">
                    <controls:HardwareBoardView x:Name="HardwareBoard"/>
                </TabItem>
                <TabItem Header="{loc:DesktopLabel Module.Taskmanager}" Tag="Taskmanager" ToolTip="{loc:DesktopLabel Module.ProcessesTip}">
                    <Border Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1.3*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:DesktopLabel Ui.TaskManagerHeading}" FontFamily="Consolas" Foreground="#24FFE3" FontSize="22"/>
                            <TextBlock Text="{Binding DashboardStatus}" Foreground="{StaticResource Muted}" Margin="0,8" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" Foreground="#E1EAF7" Background="#15102D" Padding="8" ToolTip="{loc:DesktopLabel Ui.ProcessFilterTip}"/>
                        </StackPanel>
                        <ItemsControl Grid.Row="1" x:Name="TaskmanagerCoreOverview" ItemsSource="{Binding CoreGraphs}" ItemTemplate="{StaticResource CompactCoreTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="0,6">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CoreColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding ProcessView}" x:Name="TaskmanagerProcesses" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="80"/>
                                <DataGridTextColumn Header="CPU %" Binding="{Binding CpuDisplay}" SortMemberPath="CpuPercent" Width="100"/>
                                <DataGridTextColumn Header="RAM MB" Binding="{Binding MemoryDisplay}" SortMemberPath="MemoryMb" Width="100"/>
                                <DataGridTextColumn Header="THREADS" Binding="{Binding Threads}" Width="90"/>
                                <DataGridTextColumn Header="HANDLES" Binding="{Binding Handles}" Width="90"/>
                                <DataGridTextColumn Header="READ MB/s" Binding="{Binding ReadDisplay}" SortMemberPath="ReadMbps" Width="110"/>
                                <DataGridTextColumn Header="WRITE MB/s" Binding="{Binding WriteDisplay}" SortMemberPath="WriteMbps" Width="110"/>
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Grid.Row="3">
                            <Button Content="{loc:DesktopLabel Layout.ProcessDetails}" Click="ProcessDetailsClicked" Margin="0,10,8,0"/>
                            <Button Content="{loc:DesktopLabel Ui.ProcessesHeading}" Tag="processes" Click="ManagementClicked" Margin="0,10,8,0"/>
                            <Button Content="{loc:DesktopLabel Ui.ServicesEmbedded}" Tag="services" Click="ManagementClicked" Margin="0,10,8,0"/>
                            <Button Content="{loc:DesktopLabel Ui.TaskManagerEmbedded}" Tag="tasks" Click="ManagementClicked" Margin="0,10,8,0"/>
                        </WrapPanel>
                    </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="{loc:DesktopLabel Module.Sensoren}" Tag="Sensoren" ToolTip="{loc:DesktopLabel Module.SensorsTip}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{loc:DesktopLabel Ui.SensorMatrixHeading}" FontSize="24"/>
                            <Button Content="{loc:DesktopLabel Layout.SensorSettings}" Tag="Einstellungen" Click="ControlCenterNavigate" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="{loc:DesktopLabel Layout.SensorSettingsTip}"/>
                            <Button Content="{loc:DesktopLabel Ui.SensorExport}" Click="ExportSensorsClicked" HorizontalAlignment="Left" ToolTip="{loc:DesktopLabel Layout.MatrixSnapshot}"/>
                            <TextBlock Text="{Binding SensorStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,8"/>
                            <TextBox Text="{Binding SensorFilter, UpdateSourceTrigger=PropertyChanged}" Background="#142438" Foreground="#DCEAF7" BorderBrush="#29425C" Padding="10" ToolTip="{loc:DesktopLabel Ui.SensorFilterTip}" AutomationProperties.Name="{loc:DesktopLabel Ui.SensorFilter}"/>
                        </StackPanel>
                        <controls:SensorChartsView x:Name="SensorCharts" Grid.Row="1"/>
                    </Grid>
                </TabItem>
                <TabItem Header="{loc:DesktopLabel Module.Laufwerke}" Tag="Laufwerke" ToolTip="{loc:DesktopLabel Module.DrivesTip}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Storage Observatory" FontSize="24"/>
                            <Button Content="{loc:DesktopLabel Layout.SmartTests}" Tag="SMART" Click="ControlCenterNavigate" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="{loc:DesktopLabel Ui.SmartJump}"/>
                            <TextBlock Text="{loc:DesktopLabel Layout.StorageNotice}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,18"/>
                            <TextBlock Text="{loc:DesktopLabel Ui.PhysicalDrives}" Foreground="#5DE5D0" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding Disks}" ItemTemplate="{StaticResource CheckTemplate}"/>
                            <TextBlock Text="{loc:DesktopLabel Layout.Volumes}" Foreground="#5DE5D0" Margin="0,18,0,12"/>
                            <ItemsControl ItemsSource="{Binding Volumes}" ItemTemplate="{StaticResource CheckTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{loc:DesktopLabel Module.Messauswertung}" Tag="Messauswertung" ToolTip="{loc:DesktopLabel Module.MeasurementsTip}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{loc:DesktopLabel Ui.StatisticsHeading}" FontSize="24" Foreground="#24FFE3" FontFamily="Consolas"/>
                            <Button Content="{loc:DesktopLabel Ui.LogViewerTab}" Click="OpenControlCenterClicked" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding SessionStatus}" Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
                            <WrapPanel>
                                <Button Content="{loc:DesktopLabel Ui.NewSession}" Click="ResetStatisticsClicked" Margin="0,0,12,0"/>
                                <Button Content="{loc:DesktopLabel Layout.PauseSession}" Click="PauseStatisticsClicked" Margin="0,0,12,0"/>
                                <Button Content="{loc:DesktopLabel Ui.StatisticsExport}" Click="ExportStatisticsClicked"/>
                            </WrapPanel>
                            <TextBlock Text="{loc:DesktopLabel Layout.SessionNotice}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <TextBox Text="{Binding StatisticsFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBox}" AutomationProperties.Name="{loc:DesktopLabel Ui.StatisticsFilter}" ToolTip="{loc:DesktopLabel Layout.SessionFilter}" Margin="0,8"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding StatisticsView}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:DesktopLabel Inventory.Component}" Binding="{Binding Hardware}" Width="2*"/>
                                <DataGridTextColumn Header="{loc:DesktopLabel Ui.SeriesColumn}" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="MIN" Binding="{Binding MinDisplay}" Width="*"/>
                                <DataGridTextColumn Header="MAX" Binding="{Binding MaxDisplay}" Width="*"/>
                                <DataGridTextColumn Header="AVG" Binding="{Binding AvgDisplay}" Width="*"/>
                                <DataGridTextColumn Header="{loc:DesktopLabel Ui.PointsColumn}" Binding="{Binding Count}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="{loc:DesktopLabel Module.Diagnose}" Tag="Diagnose" ToolTip="{loc:DesktopLabel Module.DiagnosticsTip}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:DesktopLabel Layout.DiagnoseControl}" FontSize="24" Foreground="#32D5FF" FontFamily="Consolas"/>
                            <WrapPanel Margin="0,12,0,12">
                                <Button Content="{loc:DesktopLabel Layout.WindowsDiagnostics}" Click="OpenWindowsAssistantsClicked" Margin="0,0,8,0" ToolTip="{loc:DesktopLabel Layout.AssistantsTip}"/>
                                <Button Content="{loc:DesktopLabel Ui.AdvancedControl}" Click="OpenControlCenterClicked" Margin="0,0,8,0" ToolTip="{loc:DesktopLabel Layout.ControlCenterTip}"/>
                                <Button Content="{loc:DesktopLabel Layout.MemoryResults}" Click="MemoryDiagnosticsClicked" Margin="0,0,8,0" ToolTip="{loc:DesktopLabel Layout.MemoryResultsTip}"/>
                                <Button Content="{loc:DesktopLabel Layout.ExportReport}" Click="ExportDiagnosticsClicked" ToolTip="{loc:DesktopLabel Layout.ExportReportTip}"/>
                                <Button Content="{loc:DesktopLabel Layout.Inventory}" Click="InventoryClicked" ToolTip="{loc:DesktopLabel Layout.InventoryTip}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding ProbeStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:DesktopLabel Ui.WindowsToolsHeading}" Foreground="#D45CFF" FontFamily="Consolas" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button Content="Task-Manager" Tag="taskmgr" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="{loc:DesktopLabel Layout.DeviceManager}" Tag="devices" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="{loc:DesktopLabel Ui.DiskManagement}" Tag="disks" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="{loc:DesktopLabel Ui.EventViewer}" Tag="events" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="{loc:DesktopLabel Layout.WindowsSecurity}" Tag="security" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="{loc:DesktopLabel Ui.StartupManage}" Tag="startup" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="Windows Update" Tag="updates" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="{loc:DesktopLabel Ui.NetworkWifi}" Tag="network" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="{loc:DesktopLabel Ui.TaskScheduler}" Tag="tasks" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="{loc:DesktopLabel Ui.Services}" Tag="services" Click="OpenToolClicked" Margin="0,0,8,8"/>
                                        <Button Content="{loc:DesktopLabel Layout.GodMode}" Tag="godmode" Click="OpenToolClicked" Margin="0,0,8,8"
                                                ToolTip="{loc:DesktopLabel Layout.AllTasksTip}"/>
                                        <Button Content="{loc:DesktopLabel Ui.XbarToggle}" Tag="xbar" Click="OpenToolClicked" Margin="0,0,8,8"
                                                ToolTip="{loc:DesktopLabel Layout.AdminAccess}"/>
                                    </WrapPanel>
                                    <TextBlock Text="{loc:DesktopLabel Layout.WindowsToolsNotice}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Diagnostics}" ItemTemplate="{StaticResource CheckTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{loc:DesktopLabel Module.Sicherheit}" Tag="Sicherheit" ToolTip="{loc:DesktopLabel Module.SecurityTip}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:DesktopLabel Layout.SecurityTelemetry}" FontSize="24"/>
                            <TextBlock Text="{Binding ProbeStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,10"/>
                            <TextBlock Text="{loc:DesktopLabel Layout.SecurityLegend}" Foreground="#8ABBD3" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource CheckTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Cleaner" Tag="Cleaner" ToolTip="{loc:DesktopLabel Module.CleanerTip}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{loc:DesktopLabel Layout.CleanerHeading}" FontSize="24" Foreground="#D45CFF" FontFamily="Consolas"/>
                            <TextBlock Text="{loc:DesktopLabel Layout.CleanerNotice}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                            <WrapPanel IsEnabled="{Binding CanClean}" Margin="0,0,0,12">
                                <ComboBox x:Name="CacheLevel" Width="180" SelectedIndex="0" SelectionChanged="CacheLevelChanged" Margin="0,0,12,0">
                                    <ComboBoxItem Content="{loc:DesktopLabel Ui.Fast}"/><ComboBoxItem Content="Standard"/><ComboBoxItem Content="{loc:DesktopLabel Ui.Deep}"/><ComboBoxItem Content="{loc:DesktopLabel Ui.Expert}"/>
                                </ComboBox>
                                <ComboBox x:Name="CacheTargets" Width="520" SelectionChanged="CacheTargetChanged" AutomationProperties.Name="{loc:DesktopLabel Ui.CacheCategory}"/>
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="{loc:DesktopLabel Layout.FindLargeFiles}" Click="StorageAnalysisClicked" Margin="0,0,12,0"/>
                                <Button Content="{loc:DesktopLabel Layout.CheckTemp}" Click="ScanCleanupClicked" IsEnabled="{Binding CanClean}" Margin="0,0,12,0"/>
                                <Button Content="{loc:DesktopLabel Ui.CheckVisible}" Tag="visible" Click="CleanupSelectionClicked" IsEnabled="{Binding CanClean}" Margin="0,0,8,0"/>
                                <Button Content="{loc:DesktopLabel Layout.UncheckAll}" Tag="none" Click="CleanupSelectionClicked" IsEnabled="{Binding CanClean}" Margin="0,0,8,0"/>
                                <Button Content="{loc:DesktopLabel Ui.CheckMarked}" Tag="rows" Click="CleanupSelectionClicked" IsEnabled="{Binding CanClean}" Margin="0,0,8,0"/>
                                <Button Content="{loc:DesktopLabel Layout.DeleteChecked}" Click="DeleteCleanupClicked" IsEnabled="{Binding CanClean}" BorderBrush="#FF354A" Margin="0,0,12,0"/>
                                <Button Content="{loc:DesktopLabel Ui.Cancel}" Click="CancelCleanupClicked"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding CleanupStatus}" Foreground="#32D5FF" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <TextBlock x:Name="CleanupSelectionStatus" Text="{loc:DesktopLabel Layout.CleanerInitial}" Foreground="#39FF68" TextWrapping="Wrap" Margin="0,5"/>
                            <TextBox Text="{Binding CleanupFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBox}" AutomationProperties.Name="{loc:DesktopLabel Ui.CleanerFilter}" ToolTip="{loc:DesktopLabel Layout.CleanerFilterNotice}" Margin="0,8"/>
                        </StackPanel>
                        <DataGrid x:Name="CleanupGrid" Grid.Row="1" ItemsSource="{Binding CleanupView}" SelectionMode="Extended" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{loc:DesktopLabel Layout.DeleteQuestion}" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.CanClean, RelativeSource={RelativeSource AncestorType=DataGrid}}" Checked="CleanupChecked" Unchecked="CleanupChecked" HorizontalAlignment="Center" ToolTip="{loc:DesktopLabel Layout.DeleteCheckboxTip}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:DesktopLabel Layout.CheckedFile}" Binding="{Binding Path}" Width="4*"/>
                                <DataGridTextColumn Header="{loc:DesktopLabel Ui.SizeColumn}" Binding="{Binding SizeDisplay}" Width="*"/>
                                <DataGridTextColumn Header="{loc:DesktopLabel Layout.ModifiedUtc}" Binding="{Binding LastWriteUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="{loc:DesktopLabel Module.Ereignisse}" Tag="Ereignisse" ToolTip="{loc:DesktopLabel Module.EventsTip}"><Border Style="{StaticResource Panel}"><controls:EventBrowser x:Name="EmbeddedEvents"/></Border></TabItem>
                <TabItem Header="Superadmin" Tag="Superadmin" ToolTip="{loc:DesktopLabel Module.AdminTip}"><Border Style="{StaticResource Panel}"><controls:AdminWorkbench x:Name="Workbench"/></Border></TabItem>
                <TabItem Header="Operations" Tag="Operations" ToolTip="{loc:DesktopLabel Module.OperationsTip}"><Border Style="{StaticResource Panel}"><controls:OperationsHub x:Name="Operations"/></Border></TabItem>
                <TabItem Header="{loc:DesktopLabel Module.Hilfe}" Tag="Hilfe" ToolTip="{loc:DesktopLabel Module.HelpTip}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{loc:DesktopLabel Ui.HelpCenter}" FontSize="24"/>
                            <TextBlock Text="{loc:DesktopLabel Layout.HelpNotice}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,10"/>
                            <TextBox x:Name="HelpSearch" TextChanged="HelpSearchChanged" Background="#142438" Foreground="#DCEAF7" BorderBrush="#29425C" Padding="10" ToolTip="{loc:DesktopLabel Layout.HelpSearch}" AutomationProperties.Name="{loc:DesktopLabel Layout.HelpSearchName}"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ListBox x:Name="HelpList" Background="#15102D" Foreground="#E1EAF7" BorderBrush="#29425C" SelectionChanged="HelpSelected" AutomationProperties.Name="{loc:DesktopLabel Ui.HelpTopics}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <StackPanel Margin="3">
                                        <TextBlock Text="{Binding Module}" Foreground="#D45CFF" FontSize="11"/>
                                        <TextBlock Text="{Binding Title}" Foreground="#24FFE3" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="14,0,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock x:Name="HelpTitle" FontSize="19" Foreground="#24FFE3" Text="{loc:DesktopLabel Layout.SelectHelp}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="HelpBody" Foreground="#DCEAF7" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="14" LineHeight="22"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
            <Border Grid.Row="3" BorderBrush="#203047" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
                <TextBlock Text="{Binding Footer}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
