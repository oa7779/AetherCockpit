<UserControl x:Class="SystemCockpit.Controls.AdminWorkbench"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:SystemCockpit.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SceneBackdrop}" Foreground="{DynamicResource ModernTextPrimary}">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
            <Style TargetType="Button" BasedOn="{StaticResource NeonButton}"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,4,8,4"/></Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource NeonTextBox}"/>
            <Style TargetType="DataGrid" BasedOn="{StaticResource NeonDataGrid}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{loc:DesktopLabel Ui.AdminHeading}" Foreground="#24FFE3" FontFamily="Consolas" FontSize="20"/>
            <TextBlock Text="{loc:DesktopLabel Layout.AdminNotice}" Foreground="#A8A4C5" Margin="0,8"/>
        </StackPanel>
        <Grid x:Name="SelectionControls" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="Area" SelectionChanged="AreaChanged" AutomationProperties.Name="{loc:DesktopLabel Layout.AdminArea}"/>
            <ComboBox x:Name="Operation" Grid.Column="1" AutomationProperties.Name="{loc:DesktopLabel Ui.AdminAction}"/>
            <Button Grid.Column="2" Content="{loc:DesktopLabel Layout.ReadAdmin}" Click="ReadClicked"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBox x:Name="Filter" TextChanged="FilterChanged" ToolTip="{loc:DesktopLabel Ui.TableFilter}" Margin="0,0,0,8" AutomationProperties.Name="{loc:DesktopLabel Ui.AdminFilter}"/>
            <DataGrid x:Name="Entities" Grid.Row="1" SelectionMode="Single" SelectionChanged="EntityChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*"/>
                    <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <StackPanel Grid.Row="3">
            <TextBlock x:Name="AreaDescription" Foreground="#FFB86C" Margin="0,6"/>
            <TextBox x:Name="Parameter" ToolTip="{loc:DesktopLabel Layout.AdminParameter}" AutomationProperties.Name="{loc:DesktopLabel Ui.AdminParameter}"/>
            <WrapPanel x:Name="ActionControls">
                <Button Content="{loc:DesktopLabel Layout.ChangePreview}" Click="PreviewClicked"/>
                <Button Content="{loc:DesktopLabel Layout.ApplyPreview}" Click="ApplyClicked"/>
                <Button Content="{loc:DesktopLabel Layout.UndoAction}" Click="UndoClicked"/>
                <Button Content="{loc:DesktopLabel Ui.CancelAction}" Click="CancelClicked"/>
            </WrapPanel>
        </StackPanel>
        <TextBox x:Name="Console" Grid.Row="4" Background="#000000" Foreground="#83FFB0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="{loc:DesktopLabel Ui.AdminConsole}"/>
        <TextBlock x:Name="Status" Grid.Row="5" Text="{loc:DesktopLabel Layout.AdminReady}" Foreground="#32D5FF" Margin="0,8"/>
    </Grid>
</UserControl>
