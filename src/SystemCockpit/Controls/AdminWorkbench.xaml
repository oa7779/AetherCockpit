<UserControl x:Class="SystemCockpit.Controls.AdminWorkbench"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E1EAF7"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
            <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource GlossButton}"/><Setter Property="Foreground" Value="#24FFE3"/><Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderAlt}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,4,8,4"/></Style>
            <Style TargetType="TextBox"><Setter Property="Background" Value="#080516"/><Setter Property="Foreground" Value="#E1EAF7"/><Setter Property="BorderBrush" Value="#7944B5"/><Setter Property="Padding" Value="8"/></Style>
            <Style TargetType="DataGrid"><Setter Property="Background" Value="#15102D"/><Setter Property="Foreground" Value="#E1EAF7"/><Setter Property="RowBackground" Value="#15102D"/><Setter Property="AlternatingRowBackground" Value="#25153D"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#39204E"/><Setter Property="Foreground" Value="#24FFE3"/><Setter Property="Padding" Value="8"/></Style></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="SUPERADMIN // EINGEBETTETE SYSTEMVERWALTUNG" Foreground="#24FFE3" FontFamily="Consolas" FontSize="20"/>
            <TextBlock Text="Vorschau → Bestaetigung → Aktion → Status neu lesen. Keine Sicherheitsumgehung, keine TrustedInstaller-Rechte. Jede Aenderung ist eigenverantwortlich; Ruecknahmen nur wo vorhanden." Foreground="#A8A4C5" Margin="0,8"/>
        </StackPanel>
        <Grid x:Name="SelectionControls" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="Area" SelectionChanged="AreaChanged" AutomationProperties.Name="Superadmin Bereich"/>
            <ComboBox x:Name="Operation" Grid.Column="1" AutomationProperties.Name="Superadmin Aktion"/>
            <Button Grid.Column="2" Content="Status / Tabelle lesen" Click="ReadClicked"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBox x:Name="Filter" TextChanged="FilterChanged" ToolTip="Tabellenfilter" Margin="0,0,0,8" AutomationProperties.Name="Superadmin Filter"/>
            <DataGrid x:Name="Entities" Grid.Row="1" SelectionMode="Single" SelectionChanged="EntityChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*"/>
                    <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <StackPanel Grid.Row="3">
            <TextBlock x:Name="AreaDescription" Foreground="#FFB86C" Margin="0,6"/>
            <TextBox x:Name="Parameter" ToolTip="WinGet-ID/Suchbegriff, DNS-IPs, Proxy, Gruppenmitglied oder ACL-Pfad; je nach Bereich" AutomationProperties.Name="Superadmin Parameter"/>
            <WrapPanel x:Name="ActionControls">
                <Button Content="Aenderungsvorschau" Click="PreviewClicked"/>
                <Button Content="Vorschau bestaetigen / anwenden" Click="ApplyClicked"/>
                <Button Content="Letzte reversible Aktion zuruecknehmen" Click="UndoClicked"/>
                <Button Content="Aktion abbrechen" Click="CancelClicked"/>
            </WrapPanel>
        </StackPanel>
        <TextBox x:Name="Console" Grid.Row="4" Background="#000000" Foreground="#83FFB0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Superadmin Konsole"/>
        <TextBlock x:Name="Status" Grid.Row="5" Text="Bereit. Keine Systemaenderung automatisch gestartet." Foreground="#32D5FF" Margin="0,8"/>
    </Grid>
</UserControl>
