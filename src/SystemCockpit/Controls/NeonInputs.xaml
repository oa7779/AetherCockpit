<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:SystemCockpit.Controls">
    <Style x:Key="NeonButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource GlossButton}"/>
        <Setter Property="Foreground" Value="#DCEAF7"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" controls:AetherNeonFrame.Enabled="True" controls:AetherNeonFrame.BreathingEnabled="False" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2,1,1,1" CornerRadius="18,4,18,4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#24FFE3"/><Setter TargetName="Frame" Property="Background" Value="#242047"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#24FFE3"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NeonTextBox" TargetType="TextBox">
        <Setter Property="controls:AetherNeonFrame.Enabled" Value="True"/>
        <Setter Property="controls:AetherNeonFrame.BreathingEnabled" Value="False"/>
        <Setter Property="Background" Value="#1A1230"/>
        <Setter Property="Foreground" Value="#E1EAF7"/>
        <Setter Property="BorderBrush" Value="#7944B5"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource ModernSelection}"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    <Style x:Key="NeonTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="#32D5FF"/>
        <Setter Property="Background" Value="#211536"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
            <Border x:Name="TabFrame" controls:AetherNeonFrame.Enabled="True" controls:AetherNeonFrame.BreathingEnabled="False" Background="{TemplateBinding Background}" BorderBrush="#7944B5" BorderThickness="1" CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                <ContentPresenter ContentSource="Header"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabFrame" Property="Background" Value="#352451"/><Setter TargetName="TabFrame" Property="BorderBrush" Value="#24FFE3"/><Setter Property="Foreground" Value="#24FFE3"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabFrame" Property="BorderBrush" Value="#FFCE54"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NeonTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource SceneBackdrop}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModernBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="ItemContainerStyle" Value="{DynamicResource NeonTabItem}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" Margin="0,0,0,4"/>
                <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                      KeyboardNavigation.TabNavigation="Local"/>
                </Border>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NeonDataGridRow" TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ModernSelection}"/>
                <Setter Property="Foreground" Value="{DynamicResource ModernAccent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="NeonDataGridCell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ModernSelection}"/>
                <Setter Property="Foreground" Value="{DynamicResource ModernAccent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ModernAccent}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="NeonDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="#100C24"/>
        <Setter Property="Foreground" Value="#DCEAF7"/>
        <Setter Property="RowBackground" Value="#100C24"/>
        <Setter Property="AlternatingRowBackground" Value="#1A1232"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="RowHeight" Value="36"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowStyle" Value="{StaticResource NeonDataGridRow}"/>
        <Setter Property="CellStyle" Value="{StaticResource NeonDataGridCell}"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value><Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#261442"/>
                <Setter Property="Foreground" Value="#32D5FF"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NeonCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#39FF68"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Box" Width="18" Height="18" Background="#080D13" BorderBrush="#8734C5" BorderThickness="1.5" CornerRadius="2" VerticalAlignment="Center">
                    <TextBlock x:Name="Mark" Text="X" Foreground="#39FF68" FontFamily="Consolas" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
                </Border>
                <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#39FF68"/><Setter TargetName="Box" Property="Background" Value="#123720"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#24FFE3"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#FFCE54"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource NeonCheckBox}"/>
    <Style TargetType="DataGridCell" BasedOn="{StaticResource NeonDataGridCell}"/>
    <Style TargetType="DataGridRow" BasedOn="{StaticResource NeonDataGridRow}"/>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#E1EAF7"/>
        <Setter Property="Background" Value="#15102D"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemFrame" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#3D205C"/><Setter Property="Foreground" Value="#24FFE3"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#293953"/><Setter Property="Foreground" Value="#24FFE3"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="#15102D"/>
        <Setter Property="Foreground" Value="#E1EAF7"/>
        <Setter Property="BorderBrush" Value="#7944B5"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,4,8,10"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Frame" Background="#15102D" BorderBrush="#7944B5" BorderThickness="1" CornerRadius="5">
                                <TextBlock Text="v" Foreground="#24FFE3" HorizontalAlignment="Right" Margin="10" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#24FFE3"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="Selection" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="8,6,30,6"
                                      IsHitTestVisible="False" VerticalAlignment="Center"/>
                    <TextBox x:Name="PART_EditableTextBox" Margin="4,3,30,3" Visibility="Collapsed"
                             Background="#15102D" Foreground="#E1EAF7" BorderThickness="0" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                        <Border Background="#15102D" BorderBrush="#24FFE3" BorderThickness="1"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}">
                            <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEditable" Value="True">
                        <Setter TargetName="Selection" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#24FFE3"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource NeonButton}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource NeonTextBox}"/>
    <Style TargetType="DataGrid" BasedOn="{StaticResource NeonDataGrid}"/>
    <Style TargetType="TabControl" BasedOn="{StaticResource NeonTabControl}"/>
    <Style TargetType="TabItem" BasedOn="{StaticResource NeonTabItem}"/>
    <Style x:Key="NeonToggleButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource GlossButton}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModernBorder}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ModernSelection}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ModernAccent}"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ModernAccent}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ModernWarning}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource NeonToggleButton}"/>
    <Style x:Key="NeonListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource ModernInput}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModernBorder}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBox" BasedOn="{StaticResource NeonListBox}"/>
    <Style TargetType="ListView" BasedOn="{StaticResource NeonListBox}"/>
    <Style x:Key="NeonListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ModernHover}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ModernSelection}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ModernAccent}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource NeonListItem}"/>
    <Style TargetType="ListViewItem">
        <Setter Property="Background" Value="{DynamicResource ModernInput}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModernBorder}"/>
        <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ModernSelection}"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{DynamicResource GlossPanel}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModernBorder}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
    </Style>
    <Style TargetType="RichTextBox">
        <Setter Property="Background" Value="{DynamicResource ModernInput}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModernBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Background" Value="{DynamicResource GlossPanel}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModernBorder}"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Background" Value="{DynamicResource SceneBackdrop}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModernBorder}"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Top" Style="{StaticResource NeonToggleButton}" Background="Transparent"
                                  HorizontalContentAlignment="Left"
                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="Disclosure" Data="M 0 0 L 4 4 L 8 0" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform Angle="-90"/></Path.RenderTransform>
                            </Path>
                            <ContentPresenter ContentSource="Header"/>
                        </StackPanel>
                    </ToggleButton>
                    <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed" Margin="0,6,0,0"/>
                </DockPanel>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Disclosure" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
            </Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WorkbenchPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlossPanel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassRim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10,3,10,3"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="controls:AetherNeonFrame.Enabled" Value="True"/>
        <Setter Property="controls:AetherNeonFrame.BreathingEnabled" Value="False"/>
    </Style>
    <Style x:Key="StatusPanel" TargetType="Border" BasedOn="{StaticResource WorkbenchPanel}">
        <Setter Property="Padding" Value="8"/>
    </Style>
    <Style x:Key="ResultPanel" TargetType="Border" BasedOn="{StaticResource WorkbenchPanel}"/>
    <Style x:Key="AssistantPanel" TargetType="Border" BasedOn="{StaticResource WorkbenchPanel}"/>
    <Style x:Key="ModelPanel" TargetType="Border" BasedOn="{StaticResource WorkbenchPanel}"/>
</ResourceDictionary>
