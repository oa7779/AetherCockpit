<UserControl x:Class="SystemCockpit.Controls.AnimatedBrand"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 IsHitTestVisible="False">
 <Viewbox Stretch="Uniform">
  <StackPanel Width="168">
   <Grid Width="112" Height="112" ClipToBounds="True">
    <Image x:Name="Logo" Source="/SystemCockpit;component/Assets/aether-logo.png" Stretch="Uniform"/>
    <Rectangle x:Name="Reflection" Opacity="0">
     <Rectangle.OpacityMask>
      <ImageBrush ImageSource="/SystemCockpit;component/Assets/aether-logo.png" Stretch="Uniform"/>
     </Rectangle.OpacityMask>
     <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
       <GradientStop Color="#00FFFFFF" Offset="0.35"/>
       <GradientStop Color="#A0FFFFFF" Offset="0.5"/>
       <GradientStop Color="#00FFFFFF" Offset="0.65"/>
       <LinearGradientBrush.RelativeTransform>
        <TranslateTransform x:Name="Sweep" X="-1.5"/>
       </LinearGradientBrush.RelativeTransform>
      </LinearGradientBrush>
     </Rectangle.Fill>
    </Rectangle>
   </Grid>
   <TextBlock x:Name="Wordmark" Text="A E T H E R" FontFamily="Arial Black" FontStyle="Italic"
              FontWeight="Black" FontSize="23" TextAlignment="Center" Margin="0,10,5,4">
    <TextBlock.Foreground>
     <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFFF" Offset="0"/>
      <GradientStop Color="#BFD4FF" Offset="0.42"/>
      <GradientStop Color="#6240AC" Offset="0.48"/>
      <GradientStop Color="#F6C8FF" Offset="0.54"/>
      <GradientStop Color="#E54BC5" Offset="0.8"/>
      <GradientStop Color="#7F38CB" Offset="1"/>
     </LinearGradientBrush>
    </TextBlock.Foreground>
    <TextBlock.Effect><DropShadowEffect Color="#DC46E8" BlurRadius="9" ShadowDepth="2" Direction="270" Opacity="0.65"/></TextBlock.Effect>
   </TextBlock>
  </StackPanel>
 </Viewbox>
</UserControl>
