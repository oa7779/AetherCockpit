<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:loc="clr-namespace:SystemCockpit.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:SystemCockpit.Controls">
    <Style x:Key="UnavailableLabel" TargetType="TextBlock">
        <Setter Property="Text" Value="{loc:DesktopLabel Layout.Unavailable}"/>
        <Setter Property="Foreground" Value="#9D92B5"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Value}" Value="--"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="CurveTemplate">
        <Viewbox Stretch="Fill" Height="52" Margin="0,6,0,2">
            <Canvas Width="280" Height="56" ClipToBounds="True">
                <Line X1="0" X2="280" Y1="0" Y2="0" Stroke="#493362"/>
                <Line X1="0" X2="280" Y1="28" Y2="28" Stroke="#30233F"/>
                <Line X1="0" X2="280" Y1="56" Y2="56" Stroke="#493362"/>
                <Polyline Points="{Binding Trace}" Stroke="{Binding Accent}" StrokeThickness="8" Opacity="0.12"/>
                <Polyline Points="{Binding Trace}" Stroke="{Binding Accent}" StrokeThickness="4.5" Opacity="0.28"/>
                <Polyline Points="{Binding Trace}" Stroke="{Binding Accent}" StrokeThickness="2"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>
    <DataTemplate x:Key="MetricTemplate">
        <Border Margin="2,3" Padding="9" Background="#60152239" BorderBrush="{Binding Accent}"
                BorderThickness="1" CornerRadius="7" ToolTip="{Binding Detail}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}" FontFamily="Consolas" FontSize="11"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <controls:NeonGauge Level="{Binding Level}" Accent="{Binding Accent}" Width="78" Height="78"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="19" FontWeight="Bold"><Run Text="{Binding Value, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Unit, Mode=OneWay}"/></TextBlock>
                        <TextBlock Style="{StaticResource UnavailableLabel}"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CurveTemplate}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="HistoryTemplate">
        <Border Margin="2,3" Padding="9" Background="#60152239" BorderBrush="{Binding Accent}"
                BorderThickness="1" CornerRadius="7" ToolTip="{Binding Detail}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}" FontFamily="Consolas" FontSize="10"/>
                    <TextBlock Text="{Binding Value}" HorizontalAlignment="Right" FontWeight="Bold" Margin="8,0,0,0"/>
                </DockPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CurveTemplate}"/>
                <TextBlock Style="{StaticResource UnavailableLabel}"/>
                <TextBlock Text="{Binding Detail}" Foreground="#9D92B5" FontSize="9" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="VolumeTemplate">
        <Border Margin="2,3" Padding="9" Background="#60152239" BorderBrush="#32D5FF"
                BorderThickness="1" CornerRadius="7" ToolTip="{Binding Detail}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" Foreground="#32D5FF" FontFamily="Consolas" FontWeight="Bold"/>
                <controls:DrivePie FreePercent="{Binding FreePercent}" Width="108" Height="108"
                                   HorizontalAlignment="Center" Margin="0,5" ToolTip="{Binding UsageSummary}"/>
                <TextBlock Text="{Binding UsageSummary}" HorizontalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
                <TextBlock HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="10">
                    <Run Text="{loc:DesktopLabel Layout.Used}" Foreground="#A84FFF"/><Run Text="  /  "/><Run Text="{loc:DesktopLabel Layout.Free}" Foreground="#24FFE3"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
