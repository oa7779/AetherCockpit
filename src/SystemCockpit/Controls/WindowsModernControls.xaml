<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="NeonButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource GlossButton}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ModernHover}"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ModernAccent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ModernAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource NeonButton}"/>
    <Style x:Key="NeonTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource ModernInput}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModernBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="Padding" Value="7"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource NeonTextBox}"/>
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource WindowBackdrop}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="NeonCheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource NeonCheckBox}"/>
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="ModernComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{DynamicResource ModernInput}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModernBorder}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"/>
                        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"><Grid>
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12"
                                              Data="M 0 0 L 4 4 L 8 0"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                              StrokeThickness="1.5"/>
                                    </Grid></Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Selection" Margin="8,5,32,5" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                        <TextBox x:Name="PART_EditableTextBox" Margin="4,3,30,3" Visibility="Collapsed"
                                 Background="{DynamicResource ModernInput}" Foreground="{DynamicResource ModernTextPrimary}"
                                 BorderThickness="0" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border x:Name="PopupFrame" Background="{DynamicResource ModernInput}"
                                    BorderBrush="{DynamicResource ModernBorder}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="Selection" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ModernAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ModernTextDisabled}"/>
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ModernDisabledBackground}"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Foreground" Value="{DynamicResource ModernTextDisabled}"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Background" Value="{DynamicResource ModernDisabledBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource ModernComboBox}"/>
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="{DynamicResource ModernInput}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
            </ControlTemplate></Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource ModernHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ModernSelection}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource ModernTextDisabled}"/>
                <Setter Property="Background" Value="{DynamicResource ModernDisabledBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource ModernInput}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModernBorder}"/>
    </Style>
    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ModernSelection}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
    </Style>
    <Style x:Key="NeonTabItem" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource GlossButton}"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource ModernBorder}" BorderThickness="1"
                            CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,3,0">
                        <ContentPresenter ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource GlossPanel}"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ModernAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource NeonTabItem}"/>
    <Style x:Key="NeonDataGrid" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{DynamicResource SceneBackdrop}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="RowBackground" Value="{DynamicResource SceneBackdrop}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource GlossPanel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModernBorder}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ModernBorder}"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="{DynamicResource GlossPanel}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ModernBorder}"/>
                    <Setter Property="Padding" Value="9,6"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource NeonDataGrid}"/>
    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModernBorder}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ModernSelection}"/>
                <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource ModernTextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource GlossPanel}"/>
    </Style>
</ResourceDictionary>
