<UserControl x:Class="SystemCockpit.Controls.GuardianView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="KeyPressed"
             Foreground="{DynamicResource ModernTextPrimary}">
    <UserControl.Resources>
        <Style x:Key="GuardianPrimaryAction" TargetType="Button" BasedOn="{StaticResource NeonButton}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ModernAccent}"/>
        </Style>
        <Style x:Key="GuardianSecondaryAction" TargetType="Button" BasedOn="{StaticResource NeonButton}">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="GuardianDangerAction" TargetType="Button" BasedOn="{StaticResource GuardianSecondaryAction}">
            <Setter Property="BorderBrush" Value="#FF6B8C"/>
        </Style>
        <Style x:Key="GuardianContextAction" TargetType="Button" BasedOn="{StaticResource GuardianSecondaryAction}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="29"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource WindowBackdrop}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="AETHER Guardian" FontSize="24" FontFamily="Consolas"
                               Foreground="{DynamicResource ModernAccent}"/>
                    <TextBlock Text="Lokale Wiederherstellung, kontrollierte Aktionen und Rückwege"
                               FontSize="14" Margin="0,3,0,9"
                               Foreground="{DynamicResource ModernTextSecondary}"/>
                    <Border Background="Transparent" BorderBrush="#352451" BorderThickness="0,0,0,1"
                            Padding="0,5,0,8">
                        <StackPanel>
                            <WrapPanel>
                                <StackPanel Width="205" Margin="0,0,10,3">
                                    <TextBlock Text="GUARDIAN-STATUS" FontSize="11"
                                               Foreground="{DynamicResource ModernTextSecondary}"/>
                                    <TextBlock x:Name="StatusState" Text="Noch nicht geprüft" FontSize="14"
                                               Foreground="{DynamicResource ModernAccent}"/>
                                </StackPanel>
                                <StackPanel Width="205" Margin="0,0,10,3">
                                    <TextBlock Text="OFFENE VORGÄNGE" FontSize="11"
                                               Foreground="{DynamicResource ModernTextSecondary}"/>
                                    <TextBlock x:Name="OpenCount" Text="—" FontSize="14"/>
                                </StackPanel>
                                <StackPanel Width="205" Margin="0,0,10,3">
                                    <TextBlock Text="ZUSTANDSAUFNAHMEN" FontSize="11"
                                               Foreground="{DynamicResource ModernTextSecondary}"/>
                                    <TextBlock x:Name="RecoveryPointCount" Text="—" FontSize="14"/>
                                </StackPanel>
                                <StackPanel Width="205" Margin="0,0,10,3">
                                    <TextBlock Text="LETZTE PRÜFUNG" FontSize="11"
                                               Foreground="{DynamicResource ModernTextSecondary}"/>
                                    <TextBlock x:Name="LastCheck" Text="—" FontSize="14"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,6,0,0"
                                       AutomationProperties.LiveSetting="Polite"
                                       Text="Guardian ist inaktiv. Keine automatische Systemaktion, Inventur oder ETW-Sitzung."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="1" Background="Transparent" BorderBrush="#352451"
                        BorderThickness="0,0,0,1" Margin="0,8,0,0" Padding="0,7,0,9">
                    <StackPanel>
                        <TextBlock Text="VORGANG" FontSize="12" FontFamily="Consolas"
                                   Foreground="{DynamicResource ModernAccent}" Margin="0,0,0,6"/>
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Vorgangsart" FontSize="12" Margin="0,0,0,2"/>
                                <ComboBox x:Name="Area" MinWidth="205" Height="36" Margin="0"
                                          SelectedIndex="0" SelectedValuePath="Tag"
                                          SelectionChanged="FilterChanged"
                                          AutomationProperties.Name="Guardian-Vorgangstyp">
                                    <ComboBoxItem Content="Wiederherstellungsarchiv" Tag="Recovery Vault"/>
                                    <ComboBoxItem Content="Änderungsjournal" Tag="Change Journal"/>
                                    <ComboBoxItem Content="Rückwegplanung" Tag="Rollback Center"/>
                                    <ComboBoxItem Content="Wiederherstellungsstatus" Tag="Recovery Readiness"/>
                                    <ComboBoxItem Content="Softwarebestand" Tag="Softwaremanifest"/>
                                    <ComboBoxItem Content="Installationsvergleich" Tag="Installation Observer"/>
                                    <ComboBoxItem Content="Updateverlauf" Tag="Update Intelligence"/>
                                    <ComboBoxItem Content="Treiberstatus" Tag="Driver Guard"/>
                                    <ComboBoxItem Content="Absturz- und Hangdiagnose" Tag="Crash Lab"/>
                                    <ComboBoxItem Content="ETW-Tiefendiagnose" Tag="Deep Trace"/>
                                    <ComboBoxItem Content="Wartungsablauf" Tag="Maintenance Window"/>
                                    <ComboBoxItem Content="Sicherungs- und Supportpakete" Tag="Rescue Package"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0" ToolTip="Optionaler Name für die gespeicherte Zustandsaufnahme oder den Wartungsablauf.">
                                <TextBlock x:Name="EntryNameLabel" Text="Name des Vorgangs (optional)" FontSize="12" Margin="0,0,0,2"/>
                                <TextBox x:Name="EntryName" Width="190" Height="36" MaxLength="160"
                                         Margin="0" Padding="7" Style="{DynamicResource NeonTextBox}"
                                         AutomationProperties.Name="Name des Vorgangs"
                                         AutomationProperties.LabeledBy="{Binding ElementName=EntryNameLabel}"/>
                            </StackPanel>
                            <Button x:Name="PrepareButton" Content="Vorgang vorbereiten" Click="PrepareClicked"
                                    Style="{DynamicResource GuardianPrimaryAction}"
                                    AutomationProperties.Name="Guardian-Vorgang vorbereiten"
                                    ToolTip="Bereitet den gewählten Guardian-Arbeitsbereich vor. Änderungen werden nicht ohne eine eigene Bestätigung ausgeführt."/>
                            <Button x:Name="OpenButton" Content="Vorgang öffnen" Click="OpenSelected"
                                    Visibility="Collapsed" Style="{DynamicResource GuardianSecondaryAction}"
                                    ToolTip="Öffnet die Details des ausgewählten lokalen Guardian-Vorgangs."/>
                            <Button x:Name="CancelButton" Content="Abbrechen" Click="CancelClicked"
                                    Visibility="Collapsed" Style="{DynamicResource GuardianSecondaryAction}"
                                    ToolTip="Beendet die eigene laufende Arbeit kontrolliert. Bereits erfolgte Änderungen werden nicht zurückgenommen."/>
                        </WrapPanel>
                        <WrapPanel Margin="0,5,0,0" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Vorgänge filtern" FontSize="12" Margin="0,0,0,2"/>
                                <TextBox x:Name="Search" MinWidth="205" Height="36" Margin="0" Padding="7"
                                         TextChanged="FilterChanged" Style="{DynamicResource NeonTextBox}"
                                         AutomationProperties.Name="Guardian-Identität oder Name suchen"/>
                            </StackPanel>
                            <TextBlock x:Name="OperationHint" Text="Vorhandene lokale Guardian-Daten werden nur auf ausdrückliche Aktion gelesen."
                                       MaxWidth="520" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ModernTextSecondary}" Margin="0,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Expander Grid.Row="2" x:Name="ActionsExpander"
                          Header="Weitere Aktionen und technische Werkzeuge" IsExpanded="False" Margin="0,7,0,0"
                          ToolTip="Zusätzliche Aktionen erscheinen passend zum ausgewählten Guardian-Arbeitsbereich.">
                    <StackPanel Margin="4">
                        <TextBlock Text="ALLGEMEIN" FontSize="11" FontFamily="Consolas"
                                   Foreground="{DynamicResource ModernTextSecondary}" Margin="0,2,0,2"/>
                        <WrapPanel x:Name="GeneralTools">
                            <Button Content="Vorgänge laden" Click="CommandClicked" Tag="load"
                                    Style="{DynamicResource GuardianSecondaryAction}"
                                    ToolTip="Lädt lokale Einträge und zeigt den Wiederherstellungsstatus an. Keine Systemänderung."/>
                            <Button x:Name="DeleteButton" Content="Ausgewählten Eintrag löschen"
                                    Click="CommandClicked" Tag="delete" Visibility="Collapsed"
                                    Style="{DynamicResource GuardianDangerAction}"
                                    ToolTip="Löscht nach Auswahl und Bestätigung nur diesen lokalen Eintrag. Aktive Vorgänge und Abhängigkeiten bleiben geschützt."/>
                        </WrapPanel>

                        <TextBlock x:Name="RecoveryToolsHeader" Text="AUFNAHMEN UND STATUS" FontSize="11"
                                   FontFamily="Consolas" Foreground="{DynamicResource ModernTextSecondary}"
                                   Margin="0,5,0,2" Visibility="Collapsed"/>
                        <WrapPanel x:Name="RecoveryTools" Visibility="Collapsed">
                            <Button Content="Zustandsaufnahme speichern" Click="CommandClicked" Tag="point"
                                    Style="{DynamicResource GuardianSecondaryAction}"
                                    ToolTip="Dokumentiert Systementitäten und Quellenabdeckung. Kein Dateibackup und kein Windows-Wiederherstellungspunkt."/>
                            <Button Content="Softwarebestand erfassen" Click="CommandClicked" Tag="manifest"
                                    Style="{DynamicResource GuardianSecondaryAction}"
                                    ToolTip="Speichert belegte Softwareidentitäten und Quellen. Keine Installation oder geratenen Paket-IDs."/>
                            <Button x:Name="PackageManifestButton" Content="WinGet-Liste übernehmen" Click="CommandClicked" Tag="package-manifest"
                                    Style="{DynamicResource GuardianSecondaryAction}"
                                    ToolTip="Übernimmt die bereits im Paketbereich gelesene Liste. Startet keine Installation."/>
                            <Button Content="Installationsvergleich beginnen" Click="CommandClicked" Tag="observe-start"
                                    Style="{DynamicResource GuardianSecondaryAction}"
                                    ToolTip="Speichert den Vorherzustand. Die Installation starten Sie selbst; danach erfassen Sie den Nachherzustand."/>
                            <Button x:Name="ObservationCompleteButton" Content="Nachherzustand erfassen" Click="CommandClicked" Tag="observe-stop" Visibility="Collapsed"
                                    Style="{DynamicResource GuardianContextAction}"
                                    ToolTip="Erfasst den aktuellen Zustand und vergleicht ihn. Zeitliche Nähe beweist keine Ursache."/>
                            <Button Content="Updateverlauf erfassen" Click="CommandClicked" Tag="updates"
                                    Style="{DynamicResource GuardianSecondaryAction}"
                                    ToolTip="Liest vorhandene Updatehistorie. Sucht oder installiert keine Updates."/>
                            <Button Content="Treiberzustand als Vergleichsbasis speichern" Click="CommandClicked" Tag="drivers"
                                    Style="{DynamicResource GuardianSecondaryAction}"
                                    ToolTip="Speichert belegte Geräte- und Treiberdaten. Installiert oder sichert keinen Treiber."/>
                            <Button x:Name="DriverVerifyButton" Content="Treiber-Nachherzustand prüfen" Click="CommandClicked" Tag="drivers-verify" Visibility="Collapsed"
                                    Style="{DynamicResource GuardianContextAction}"
                                    ToolTip="Vergleicht belegte Geräteinstanzen und Status; neue Identitäten werden nicht geraten."/>
                            <Button Content="Windows-Wiederherstellungsstatus anzeigen" Click="CommandClicked" Tag="windows-recovery"
                                    Style="{DynamicResource GuardianSecondaryAction}"
                                    ToolTip="Führt reagentc /info lesend aus. Aktiviert, erstellt oder startet keine Wiederherstellung."/>
                            <Button Content="AETHER-Konfiguration sichern" Click="CommandClicked" Tag="configuration-backup"
                                    Style="{DynamicResource GuardianSecondaryAction}"
                                    ToolTip="Speichert die aktuelle AETHER-Konfiguration lokal im Wiederherstellungsarchiv."/>
                            <Button x:Name="ConfigurationPlanButton" Content="Konfigurationsrückweg vorbereiten" Click="CommandClicked" Tag="configuration-plan" Visibility="Collapsed"
                                    Style="{DynamicResource GuardianContextAction}"
                                    ToolTip="Erstellt einen Plan, ändert die Konfiguration aber noch nicht. Ausführung separat bestätigen."/>
                        </WrapPanel>

                        <TextBlock x:Name="ActionToolsHeader" Text="KONTROLLIERTE SYSTEMAKTIONEN" FontSize="11"
                                   FontFamily="Consolas" Foreground="{DynamicResource ModernTextSecondary}"
                                   Margin="0,5,0,2" Visibility="Collapsed"/>
                        <WrapPanel x:Name="ActionTools" Visibility="Collapsed">
                            <ComboBox x:Name="TargetKind" MinWidth="150" Height="36" SelectedIndex="0"
                                      AutomationProperties.Name="Zu ändernder Zieltyp"
                                      ToolTip="Wählen Sie einen Dienst, eine geplante Aufgabe oder einen Autostarteintrag. Der Änderungsplan nennt das genaue Ziel.">
                                <ComboBoxItem Content="Dienst" Tag="service"/>
                                <ComboBoxItem Content="Geplante Aufgabe" Tag="task"/>
                                <ComboBoxItem Content="Autostart" Tag="startup"/>
                            </ComboBox>
                            <TextBox x:Name="TargetId" Width="190" Height="36" Padding="7" TextChanged="TargetChanged"
                                     Style="{DynamicResource NeonTextBox}" AutomationProperties.Name="Exakte Zielidentität"
                                     ToolTip="Dienstname, vollständiger Taskpfad oder HKCU\Run-Wertname / HKLM\Run-Wertname. Windows-/AETHER-Dienste und Microsoft-Tasks sind hier geschützt."/>
                            <ComboBox x:Name="Action" MinWidth="145" Height="36" SelectedIndex="0"
                                      AutomationProperties.Name="Geplante Systemaktion"
                                      ToolTip="Ändert den Zielzustand erst nach Anzeige und Bestätigung des Änderungsplans.">
                                <ComboBoxItem Content="Starten" Tag="start"/>
                                <ComboBoxItem Content="Beenden" Tag="stop"/>
                                <ComboBoxItem Content="Neu starten" Tag="restart"/>
                                <ComboBoxItem Content="Aktivieren" Tag="enable"/>
                                <ComboBoxItem Content="Deaktivieren" Tag="disable"/>
                            </ComboBox>
                            <Button x:Name="PlanButton" Content="Änderungsplan anzeigen" Click="CommandClicked" Tag="plan"
                                    Style="{DynamicResource GuardianSecondaryAction}"
                                    ToolTip="Liest Zielidentität und Istzustand und erstellt eine Vorschau. Ändert das Ziel noch nicht."/>
                            <Button x:Name="ExecuteButton" Content="Änderungsplan bestätigen und ausführen"
                                    Click="ExecuteClicked" Visibility="Collapsed"
                                    Style="{DynamicResource GuardianDangerAction}"
                                    ToolTip="Prüfen Sie Ziel, Wirkung und Rechtebedarf. Die Aktion kann Windows oder Konfiguration ändern; ein Rückweg ist nicht automatisch garantiert."/>
                            <Button x:Name="RollbackButton" Content="Rückweg vorbereiten"
                                    Click="CommandClicked" Tag="rollback" Visibility="Collapsed"
                                    Style="{DynamicResource GuardianContextAction}"
                                    ToolTip="Erstellt nur einen Plan. Vor der Ausführung werden Identität und Zustand erneut geprüft."/>
                            <Button x:Name="RevalidateButton" Content="Offenen Vorgang erneut prüfen"
                                    Click="CommandClicked" Tag="revalidate" Visibility="Collapsed"
                                    Style="{DynamicResource GuardianContextAction}"
                                    ToolTip="Liest den tatsächlichen Zustand. Eine alte Aktion wird nicht automatisch fortgesetzt."/>
                        </WrapPanel>

                        <TextBlock x:Name="DiagnosticToolsHeader" Text="DIAGNOSE UND PAKETE" FontSize="11"
                                   FontFamily="Consolas" Foreground="{DynamicResource ModernTextSecondary}"
                                   Margin="0,5,0,2" Visibility="Collapsed"/>
                        <StackPanel x:Name="DiagnosticTools" Visibility="Collapsed">
                            <WrapPanel x:Name="CrashTools" Visibility="Collapsed">
                                <ComboBox x:Name="Crash" Width="300" Height="36" DisplayMemberPath="Title"
                                          SelectionChanged="FilterChanged"
                                          AutomationProperties.Name="Qualifizierter Absturz- oder Hangfall"
                                          ToolTip="Nur qualifizierte Windows-Absturz- und Hangereignisse werden angeboten."/>
                                <Button x:Name="CrashEvaluateButton" Content="Ausgewählten Absturz-/Hangfall auswerten"
                                        Click="CommandClicked" Tag="crash" Visibility="Collapsed"
                                        Style="{DynamicResource GuardianSecondaryAction}"
                                        ToolTip="Ordnet das ausgewählte Ereignis und belegten Kontext ein. Zeitliche Nähe beweist keine Ursache."/>
                            </WrapPanel>
                            <Expander x:Name="TraceTools" Header="ETW-Tiefendiagnose" IsExpanded="False"
                                      Visibility="Collapsed" Margin="0,3">
                                <StackPanel>
                                    <WrapPanel>
                                        <ComboBox x:Name="TraceProfile" Width="300" Height="36"
                                                  SelectionChanged="TraceProfileChanged"
                                                  AutomationProperties.Name="ETW-Tiefendiagnoseprofil"
                                                  ToolTip="Feste, begrenzte Profile; Auswahl startet keine Aufzeichnung."/>
                                        <TextBox x:Name="TraceSeconds" Text="5" Width="60" Height="36" Padding="7"
                                                 Style="{DynamicResource NeonTextBox}"
                                                 AutomationProperties.Name="ETW-Aufzeichnungsdauer in Sekunden"
                                                 ToolTip="Dauer in Sekunden; das ausgewählte Profil legt das Maximum fest."/>
                                        <Button x:Name="TraceStart" Content="Reale ETW-Aufzeichnung nicht freigegeben"
                                                IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                                                Click="TraceClicked" Style="{DynamicResource GuardianDangerAction}"
                                                ToolTip="Reale Produktaufnahme ist gesperrt. Manuelle administrative Prüfläufe sind getrennt und nicht Teil der Anwendung. Keine Selbsterhöhung."/>
                                        <Button x:Name="TraceProfileDetailsButton" Content="Profildetails anzeigen"
                                                Click="CommandClicked" Tag="trace-profile"
                                                Style="{DynamicResource GuardianContextAction}"
                                                ToolTip="Zeigt Quellen, Voraussetzungen, Grenzen und Prüfstatus. Startet keine Aufzeichnung."/>
                                    </WrapPanel>
                                    <WrapPanel x:Name="TraceComponents" Visibility="Collapsed">
                                        <CheckBox x:Name="TraceProcess" Content="Prozesskontext (immer)" IsChecked="True"
                                                  IsEnabled="False" Margin="4"
                                                  AutomationProperties.Name="ETW-Baustein Prozesskontext"
                                                  ToolTip="Der Prozesskontext ist immer enthalten und kann nicht abgewählt."/>
                                        <CheckBox x:Name="TraceCpu" Content="CPU-Samples" Margin="4"
                                                  Checked="TraceComponentsChanged" Unchecked="TraceComponentsChanged"
                                                  AutomationProperties.Name="ETW-Baustein CPU-Samples"
                                                  ToolTip="Begrenzte statistische Samples; kein CPU-Prozentwert und keine Stack-/Symbolanalyse."/>
                                        <CheckBox x:Name="TraceFile" Content="Datei-I/O" Margin="4"
                                                  Checked="TraceComponentsChanged" Unchecked="TraceComponentsChanged"
                                                  AutomationProperties.Name="ETW-Baustein Datei-I/O"
                                                  ToolTip="Erfasst Dateioperationsmetadaten, keine Datei-Inhalte."/>
                                        <CheckBox x:Name="TraceDisk" Content="Datenträger-I/O" Margin="4"
                                                  Checked="TraceComponentsChanged" Unchecked="TraceComponentsChanged"
                                                  AutomationProperties.Name="ETW-Baustein Datenträger-I/O"
                                                  ToolTip="Erfasst Datenträgerereignisse; eine Geräteaktivität ist nicht automatisch einer Datei oder Prozessinstanz zugeordnet."/>
                                        <CheckBox x:Name="TraceNetwork" Content="Netzwerk-Metadaten" Margin="4"
                                                  Checked="TraceComponentsChanged" Unchecked="TraceComponentsChanged"
                                                  AutomationProperties.Name="ETW-Baustein Netzwerk-Metadaten"
                                                  ToolTip="Erfasst Verbindungs-/Transfermetadaten, keine Paket-Inhalte."/>
                                    </WrapPanel>
                                    <TextBlock x:Name="TraceGate" Text="ETW-Basis real bestanden; Profile synthetisch geprüft, noch nicht produktiv freigegeben."
                                               TextWrapping="Wrap" MaxWidth="760" Margin="4"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <WrapPanel>
                                        <Button x:Name="TraceDecodeButton" Content="Ausgewählte ETL auswerten"
                                                Click="CommandClicked" Tag="trace-decode" Visibility="Collapsed"
                                                Style="{DynamicResource GuardianContextAction}"
                                                ToolTip="Liest die ausgewählte eigene ETL und speichert dekodierte Fakten. Die Rohdatei bleibt unverändert."/>
                                        <Button x:Name="TraceDeleteButton" Content="Ausgewählte ETL-Datei löschen"
                                                Click="CommandClicked" Tag="trace-delete" Visibility="Collapsed"
                                                Style="{DynamicResource GuardianDangerAction}"
                                                ToolTip="Löscht nach Bestätigung die inaktive Rohdatei und den Sessionmarker unwiderruflich. Dekodierte Belege bleiben bestehen."/>
                                        <Button Content="Eigene ETW-Sitzungen prüfen" Click="CommandClicked" Tag="trace-recovery"
                                                Style="{DynamicResource GuardianSecondaryAction}"
                                                ToolTip="Prüft nur eigene Sitzungsmarker. Eine aktive eigene Sitzung wird nur nach gesonderter Bestätigung beendet."/>
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="RescueTools" Header="Sicherungs- und Supportpakete" IsExpanded="False"
                                      Visibility="Collapsed" Margin="0,3">
                                <WrapPanel>
                                    <Button Content="Verschlüsseltes Wiederherstellungspaket exportieren"
                                            Click="RescueClicked" Tag="private"
                                            Style="{DynamicResource GuardianSecondaryAction}"
                                            ToolTip="Erstellt nach Inhaltsvorschau eine benutzergebunden verschlüsselte lokale Datei. Führt keine Wiederherstellung aus."/>
                                    <Button Content="Redigiertes Supportpaket exportieren"
                                            Click="RescueClicked" Tag="support"
                                            Style="{DynamicResource GuardianSecondaryAction}"
                                            ToolTip="Zeigt vorab den Inhalt und speichert eine redigierte lokale Datei. Keine automatische Weitergabe."/>
                                    <Button x:Name="InspectPrivateButton" Content="Wiederherstellungspaket prüfen"
                                            Click="CommandClicked" Tag="inspect-private" Visibility="Collapsed"
                                            Style="{DynamicResource GuardianContextAction}"
                                            ToolTip="Prüft die ausgewählte Datei auf Entschlüsselbarkeit, Integrität, Schema und Kontext. Führt keine Systemwiederherstellung aus."/>
                                </WrapPanel>
                            </Expander>
                        </StackPanel>

                        <TextBlock x:Name="MaintenanceToolsHeader" Text="WARTUNGSABLAUF" FontSize="11"
                                   FontFamily="Consolas" Foreground="{DynamicResource ModernTextSecondary}"
                                   Margin="0,5,0,2" Visibility="Collapsed"/>
                        <WrapPanel x:Name="MaintenanceTools" Visibility="Collapsed">
                            <TextBlock Text="Änderungsplan im Journal anzeigen und hier als Schritt speichern. Nach einem Neustart zuerst den aktuellen Zustand erneut prüfen."
                                       TextWrapping="Wrap" MaxWidth="360" Margin="4" VerticalAlignment="Center"/>
                            <Button x:Name="MaintenanceCreateButton" Content="Wartungsablauf planen" Click="CommandClicked" Tag="maintenance" Visibility="Collapsed"
                                    Style="{DynamicResource GuardianSecondaryAction}"
                                    ToolTip="Speichert einen unterbrechbaren Ablauf aus einzeln bestätigten Änderungsplänen."/>
                            <Button x:Name="MaintenanceAddButton" Content="Änderungsplan als Schritt ergänzen"
                                    Click="CommandClicked" Tag="maintenance-add" Visibility="Collapsed"
                                    Style="{DynamicResource GuardianContextAction}"
                                    ToolTip="Übernimmt den aktuell angezeigten Plan als noch nicht ausgeführten Wartungsschritt."/>
                            <Button x:Name="MaintenanceNextButton" Content="Nächsten Schritt bestätigen"
                                    Click="CommandClicked" Tag="maintenance-next" Visibility="Collapsed"
                                    Style="{DynamicResource GuardianDangerAction}"
                                    ToolTip="Prüft den vorbereiteten Schritt und fragt vor der einzelnen Ausführung erneut nach Bestätigung."/>
                            <Button x:Name="MaintenancePauseButton" Content="Wartungsablauf pausieren"
                                    Click="CommandClicked" Tag="pause" Visibility="Collapsed"
                                    Style="{DynamicResource GuardianContextAction}"
                                    ToolTip="Pausiert den Ablauf; bereits ausgeführte Änderungen bleiben bestehen."/>
                            <Button x:Name="MaintenanceResumeButton" Content="Fortsetzen und Zustand neu prüfen"
                                    Click="CommandClicked" Tag="resume" Visibility="Collapsed"
                                    Style="{DynamicResource GuardianContextAction}"
                                    ToolTip="Liest Host, Benutzer, Ziele und abgeschlossene Schritte neu. Wiederholt keine alte Aktion."/>
                            <Button x:Name="MaintenanceVerifyButton" Content="Nachherzustand vergleichen"
                                    Click="CommandClicked" Tag="verify-maintenance" Visibility="Collapsed"
                                    Style="{DynamicResource GuardianContextAction}"
                                    ToolTip="Vergleicht den aktuellen Zustand mit dem gespeicherten Wartungsschritt."/>
                            <Button x:Name="MaintenanceCancelButton" Content="Wartungsablauf abbrechen"
                                    Click="CommandClicked" Tag="cancel-maintenance" Visibility="Collapsed"
                                    Style="{DynamicResource GuardianDangerAction}"
                                    ToolTip="Bricht den Ablauf ab, nimmt aber bereits erfolgte Änderungen nicht zurück."/>
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <Border Grid.Row="3" Background="Transparent" BorderBrush="#352451"
                        BorderThickness="0,0,0,1" Margin="0,7,0,0" Padding="0,5,0,8">
                    <StackPanel>
                        <TextBlock Text="AKTIVE / LETZTE VORGÄNGE" FontSize="12" FontFamily="Consolas"
                                   Foreground="{DynamicResource ModernAccent}" Margin="0,0,0,5"/>
                        <Grid>
                            <DataGrid Grid.Row="0" x:Name="Rows" Style="{DynamicResource NeonDataGrid}"
                                      IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                                      SelectionChanged="Selected" EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling" MaxHeight="270"
                                      Visibility="Collapsed"
                                      AutomationProperties.Name="Guardian-Vorgänge und Recovery-Objekte">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Typ" Binding="{Binding Kind, Mode=OneTime}" Width="1.1*"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneTime}" Width="2.2*"/>
                                    <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding Created, Mode=OneTime, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding State, Mode=OneTime}" Width="1.2*"/>
                                    <DataGridTemplateColumn Header="Aktion" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Öffnen" Click="OpenRowClicked"
                                                        Style="{DynamicResource GuardianContextAction}"
                                                        ToolTip="Öffnet die Details dieses ausgewählten Guardian-Vorgangs."/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="EmptyState" Text="Vorgänge noch nicht geladen. Mit „Vorgang vorbereiten“ lokal prüfen."
                                       MinHeight="44" Padding="8" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ModernTextSecondary}"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="4" x:Name="DetailsSummary"
                           Text="Vorgang auswählen, um seine Zusammenfassung anzuzeigen."
                           TextWrapping="Wrap" Margin="2,6" AutomationProperties.LiveSetting="Polite"/>
                <Expander Grid.Row="5" x:Name="DetailsExpander"
                          Header="Technische Details und Rohdaten (JSON)" IsExpanded="False" Margin="0,2,0,0"
                          ToolTip="Aufklappen, um gespeicherte Quellen, Identitäten, Prüfungen und technische JSON-Felder einzusehen."
                          AutomationProperties.Name="Technische Guardian-Details und JSON-Rohdaten">
                    <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" MinHeight="90" MaxHeight="300"
                             FontFamily="Consolas" Style="{DynamicResource NeonTextBox}"
                             AutomationProperties.Name="Guardian-Details und JSON-Rohdaten"/>
                </Expander>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
