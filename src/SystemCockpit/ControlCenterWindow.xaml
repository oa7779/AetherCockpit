<Window x:Class="SystemCockpit.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SystemCockpit.Services"
        xmlns:services="clr-namespace:SystemCockpit.Services"
        Title="{loc:DesktopLabel ControlCenter.Title}" Width="1180" Height="1000" MinWidth="980" MinHeight="680"
        Background="{DynamicResource WindowBackdrop}" Foreground="#E1EAF7" WindowStartupLocation="CenterOwner" Icon="Assets/aether.ico">
    <Window.Resources>
        <ResourceDictionary>
        <DataTemplate x:Key="ModernCommandCatalogItem">
            <StackPanel Margin="3">
                <WrapPanel>
                    <TextBlock Tag="modern-catalog-category" Text="{Binding Category}" Foreground="{DynamicResource ModernTextSecondary}" FontFamily="Segoe UI"/>
                    <TextBlock Text="{Binding RiskBadge}" Foreground="{DynamicResource ModernWarning}" FontSize="10" Margin="8,2,0,0"/>
                </WrapPanel>
                <Button Tag="{Binding}" Content="{Binding Command}" Click="CatalogCommandClicked"
                        Style="{DynamicResource NeonButton}" FontFamily="Segoe UI" HorizontalContentAlignment="Left"/>
            </StackPanel>
        </DataTemplate>
        <DrawingBrush x:Key="Scanlines" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
            <DrawingBrush.Drawing><GeometryDrawing Brush="#16000000">
                <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,1"/></GeometryDrawing.Geometry>
            </GeometryDrawing></DrawingBrush.Drawing>
        </DrawingBrush>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E1EAF7"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#1A1230"/><Setter Property="Foreground" Value="#E1EAF7"/><Setter Property="BorderBrush" Value="#7944B5"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,8,10"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource GlossButton}"/><Setter Property="Foreground" Value="#24FFE3"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderAlt}"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,4,8,10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="GlossFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8,2,8,2" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GlossFrame" Property="BorderBrush" Value="#38FFF2"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="GlossFrame" Property="BorderBrush" Value="#38FFF2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#25143E"/>
            <Setter Property="Foreground" Value="#32D5FF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="#7944B5"
                            BorderThickness="1" CornerRadius="10,3,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                        <TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" FontFamily="Consolas"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="#3D205C"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#24FFE3"/>
                            <Setter Property="Foreground" Value="#24FFE3"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#D45CFF"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#24FFE3"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource NeonDataGrid}"><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="Background" Value="#15102D"/><Setter Property="RowBackground" Value="#15102D"/><Setter Property="Foreground" Value="#E1EAF7"/></Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="ModuleRow" Height="*"/><RowDefinition Height="6"/><RowDefinition x:Name="TerminalRow" Height="300" MinHeight="180"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{loc:DesktopLabel ControlCenter.Header}" Foreground="#D45CFF" FontFamily="Consolas" FontSize="24"/>
            <TextBlock Text="{loc:DesktopLabel ControlCenter.AdminNotice}" Foreground="#32D5FF" Margin="0,8,0,0"/>
            <Border BorderBrush="#6940A8" BorderThickness="1" CornerRadius="8" Background="#140E2C" Padding="10,6" Margin="0,10,0,0">
                <WrapPanel>
                    <Button x:Name="CcBack" Content="{loc:DesktopLabel Navigation.BackButton}" Click="CcBackClicked" IsEnabled="False" Margin="0,0,8,0"
                            ToolTip="{loc:DesktopLabel ControlCenter.BackTip}"/>
                    <Button x:Name="CcForward" Content="{loc:DesktopLabel Navigation.ForwardButton}" Click="CcForwardClicked" IsEnabled="False" Margin="0,0,8,0"
                            ToolTip="{loc:DesktopLabel Navigation.ForwardTip}"/>
                    <Button Content="{loc:DesktopLabel ControlCenter.Home}" Click="CcHomeClicked" Margin="0,0,8,0"
                            ToolTip="{loc:DesktopLabel ControlCenter.HomeTip}"/>
                    <Button Content="{loc:DesktopLabel Main.Find}" Click="TaskCenterClicked" Margin="0,0,8,0" ToolTip="{loc:DesktopLabel ControlCenter.FindTip}"/>
                    <Button Content="{loc:DesktopLabel Terminal.Toggle}" Click="ToggleTerminalClicked" Margin="0,0,8,0" ToolTip="{loc:DesktopLabel Terminal.ToggleTip}"/>
                    <TextBlock x:Name="CcTrail" Text="{loc:DesktopLabel ControlCenter.InitialTrail}" Foreground="#24FFE3" FontFamily="Consolas"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               ToolTip="{loc:DesktopLabel ControlCenter.TrailTip}"/>
                </WrapPanel>
            </Border>
        </StackPanel>
        <TabControl x:Name="Modules" Grid.Row="1" Background="{DynamicResource GlossPanel}" BorderBrush="{DynamicResource GlassRim}" SelectionChanged="ModuleChanged">
            <TabItem Header="{loc:DesktopLabel Module.Smart}" Tag="SMART" ToolTip="{loc:DesktopLabel Module.SmartTip}">
                <StackPanel Margin="14">
                    <TextBlock Text="{loc:DesktopLabel Layout.SmartHeading}" FontSize="19" Foreground="#24FFE3"/>
                    <TextBlock Text="{loc:DesktopLabel Layout.SmartNotice}" Margin="0,8,0,12"/>
                    <Button Content="{loc:DesktopLabel Layout.SmartScan}" Click="SmartScanClicked" HorizontalAlignment="Left"/>
                    <ComboBox x:Name="SmartDevices" AutomationProperties.Name="{loc:DesktopLabel Layout.SmartDevice}"/>
                    <WrapPanel><Button Content="{loc:DesktopLabel Layout.ReadSmartLogs}" Click="SmartReadClicked"/>
                        <Button Content="{loc:DesktopLabel Layout.SmartSave}" Click="SaveSmartClicked"/></WrapPanel>
                    <WrapPanel>
                        <ComboBox x:Name="SmartOperation" Width="200" SelectedIndex="0">
                            <ComboBoxItem Content="short"/><ComboBoxItem Content="long"/><ComboBoxItem Content="conveyance"/>
                            <ComboBoxItem Content="selective"/><ComboBoxItem Content="abort"/><ComboBoxItem Content="aam"/><ComboBoxItem Content="apm"/>
                        </ComboBox>
                        <TextBox x:Name="SmartArgument" Width="230" ToolTip="{loc:DesktopLabel Ui.SmartArgumentHint}" AutomationProperties.Name="{loc:DesktopLabel Ui.SmartParameter}"/>
                        <Button Content="{loc:DesktopLabel Layout.SmartExecute}" Click="SmartExecuteClicked"/>
                    </WrapPanel>
                    <TextBlock Text="{loc:DesktopLabel Layout.SmartOperationsNotice}" Foreground="#A8A4C5"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="{loc:DesktopLabel Module.Netzwerk}" Tag="Netzwerk" ToolTip="{loc:DesktopLabel Module.NetworkTip}">
                <StackPanel Margin="14">
                    <TextBlock Text="{loc:DesktopLabel Layout.NetworkHeading}" Foreground="#24FFE3" FontSize="19"/>
                    <WrapPanel><TextBox x:Name="PingHost" Width="260" Text="1.1.1.1" AutomationProperties.Name="{loc:DesktopLabel Ui.PingTarget}"/>
                        <Button Content="Ping" Click="PingClicked"/><Button Content="Router-Ping" Click="RouterPingClicked"/>
                        <Button Content="{loc:DesktopLabel Layout.PortalCheck}" Click="PortalClicked"/></WrapPanel>
                    <WrapPanel>
                        <TextBox x:Name="SpeedtestMiB" Width="80" Text="25" ToolTip="{loc:DesktopLabel Ui.TestSize}" AutomationProperties.Name="{loc:DesktopLabel Ui.SpeedSize}"/>
                        <Button Content="Speedtest Download" Click="SpeedtestClicked"/>
                        <TextBlock Text="{loc:DesktopLabel Layout.SpeedNotice}" Foreground="#A8A4C5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <WrapPanel><TextBox x:Name="LanRange" Width="260" Text="192.168.1.0/24" AutomationProperties.Name="{loc:DesktopLabel Ui.LanNetwork}"/>
                        <Button Content="{loc:DesktopLabel Ui.ScanPrivateLan}" Click="LanScanClicked"/>
                        <CheckBox x:Name="AutoLan" Content="{loc:DesktopLabel Ui.AutoScan}" Foreground="#24FFE3" VerticalAlignment="Center" Checked="AutoLanChanged" Unchecked="AutoLanChanged"/>
                    </WrapPanel>
                    <TextBlock Text="{loc:DesktopLabel Layout.LanNotice}" Margin="0,0,0,10"/>
                    <TextBlock Text="{loc:DesktopLabel Layout.WakeOnLanHeading}" Foreground="#24FFE3" Margin="0,4,0,2"/>
                    <WrapPanel>
                        <TextBox x:Name="WakeMacAddress" Width="220" ToolTip="{loc:DesktopLabel Layout.WakeOnLanMacTip}"
                                 AutomationProperties.Name="{loc:DesktopLabel Ui.WakeOnLanMac}"/>
                        <Button x:Name="WakeOnLanButton" Content="{loc:DesktopLabel Layout.WakeOnLanSend}" Click="WakeOnLanClicked"/>
                    </WrapPanel>
                    <TextBlock Text="{loc:DesktopLabel Layout.WakeOnLanNotice}" Foreground="#A8A4C5" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Button Content="{loc:DesktopLabel Ui.WifiNetworks}" Tag="wlan" Click="ActionClicked"/>
                        <Button Content="{loc:DesktopLabel Ui.WifiProfiles}" Tag="wlan-profiles" Click="ActionClicked"/>
                        <Button Content="{loc:DesktopLabel Layout.ReadArp}" Tag="neighbors" Click="ActionClicked"/>
                        <Button Content="{loc:DesktopLabel Ui.ArpClear}" Tag="arp" Click="ActionClicked"/>
                        <Button Content="Bluetooth" Tag="bluetooth" Click="ActionClicked"/>
                    </WrapPanel>
                    <DataGrid x:Name="LanGrid" Height="190" SelectionChanged="LanDeviceSelected"><DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:DesktopLabel Ui.AddressColumn}" Binding="{Binding Address}" Width="*"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*"/>
                        <DataGridTextColumn Header="MS" Binding="{Binding Milliseconds}" Width="*"/>
                        <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="*"/>
                        <DataGridTextColumn Header="{loc:DesktopLabel Layout.OuiManufacturer}" Binding="{Binding Manufacturer}" Width="2*"/>
                        <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="2*"/>
                    </DataGrid.Columns></DataGrid>
                </StackPanel>
            </TabItem>
            <TabItem Header="{loc:DesktopLabel Module.Pakete}" Tag="Pakete" ToolTip="{loc:DesktopLabel Module.PackagesTip}">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:DesktopLabel Ui.PackageCenter}" Foreground="#24FFE3" FontSize="19"/>
                        <TextBlock Text="{loc:DesktopLabel Layout.PackagesNotice}" Margin="0,6,0,6"/>
                        <WrapPanel>
                            <Button Content="{loc:DesktopLabel Layout.InstalledPackages}" Tag="list" Click="PackagesLoadClicked"/>
                            <Button Content="{loc:DesktopLabel Layout.AvailableUpdates}" Tag="upgrade" Click="PackagesLoadClicked"/>
                            <TextBox x:Name="PackageSearch" Width="240" ToolTip="{loc:DesktopLabel Layout.PackageSearchTip}" AutomationProperties.Name="{loc:DesktopLabel Layout.PackageSearch}"/>
                            <Button Content="{loc:DesktopLabel Layout.Search}" Tag="search" Click="PackagesLoadClicked"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="{loc:DesktopLabel Layout.InstallSelection}" Tag="install" Click="PackageActionClicked"/>
                            <Button Content="{loc:DesktopLabel Layout.UpgradeSelection}" Tag="upgrade" Click="PackageActionClicked"/>
                            <Button Content="{loc:DesktopLabel Layout.UpgradeAll}" Tag="upgrade-all" Click="PackageActionClicked"/>
                            <Button Content="{loc:DesktopLabel Layout.UninstallSelection}" Tag="uninstall" Click="PackageActionClicked" BorderBrush="#FF354A"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="{loc:DesktopLabel Layout.PackageDetails}" Click="PackageDetailsClicked" ToolTip="{loc:DesktopLabel Layout.PackageDetailsTip}"/>
                            <Button Content="{loc:DesktopLabel Ui.PackageExport}" Click="PackageExportClicked" ToolTip="{loc:DesktopLabel Layout.PackageExportTip}"/>
                            <Button Content="{loc:DesktopLabel Layout.PackageImport}" Click="PackageImportClicked" ToolTip="{loc:DesktopLabel Layout.PackageImportTip}"/>
                            <Button Content="{loc:DesktopLabel Ui.OtherManagers}" Click="ExternalPackagesClicked" ToolTip="{loc:DesktopLabel Layout.ExternalPackagesTip}"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="PackagesGrid" Grid.Row="1" MinHeight="160" SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="2*"/>
                            <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="*"/>
                            <DataGridTextColumn Header="{loc:DesktopLabel Layout.Available}" Binding="{Binding Available}" Width="*"/>
                            <DataGridTextColumn Header="{loc:DesktopLabel Layout.Source}" Binding="{Binding Source}" Width="*"/>
                            <DataGridTextColumn Header="{loc:DesktopLabel Ui.ActionableColumn}" Binding="{Binding ActionableDisplay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="PackagesInfo" Grid.Row="2" Foreground="#32D5FF" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="{loc:DesktopLabel Layout.PackageInitial}"/>
                </Grid>
            </TabItem>
            <TabItem Header="{loc:DesktopLabel Module.Auftraege}" Tag="Auftraege" ToolTip="{loc:DesktopLabel Module.JobsTip}">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="{loc:DesktopLabel Layout.JobsNotice}" Foreground="#24FFE3" Margin="0,0,0,10"/>
                    <DataGrid x:Name="JobsGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:DesktopLabel Layout.Time}" Binding="{Binding Created, StringFormat=HH:mm:ss}" Width="85"/>
                            <DataGridTextColumn Header="{loc:DesktopLabel Layout.Job}" Binding="{Binding Label}" Width="2*"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding StateDisplay}" Width="170"/>
                            <DataGridTextColumn Header="{loc:DesktopLabel Layout.ResultLimits}" Binding="{Binding Detail}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="{loc:DesktopLabel Module.Wartung}" Tag="Wartung" ToolTip="{loc:DesktopLabel Module.MaintenanceTip}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
                    <TextBlock x:Name="CommandCatalogHeading" Text="{loc:DesktopLabel Ui.AdminCatalogHeading}" Foreground="#24FFE3" FontSize="19"/>
                    <TextBlock x:Name="CommandCatalogNotice" Text="{loc:DesktopLabel Layout.CommandsNotice}" Margin="0,6,0,6"/>
                    <WrapPanel>
                        <CheckBox x:Name="ExpertToggle" Content="{loc:DesktopLabel Ui.ExpertMode}" Foreground="#FFB86C" VerticalAlignment="Center"
                                  Checked="ExpertModeChanged" Unchecked="ExpertModeChanged"
                                  ToolTip="{loc:DesktopLabel Layout.ExpertTip}"/>
                        <TextBlock x:Name="ModeHint" Foreground="#A8A4C5" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <TextBlock x:Name="OsCompat" Foreground="#A8A4C5" Margin="0,2,0,6"/>
                    <TextBox x:Name="CommandSearch" TextChanged="CommandSearchChanged" AutomationProperties.Name="{loc:DesktopLabel Layout.CommandSearch}" ToolTip="{loc:DesktopLabel Layout.CommandSearchTip}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ListBox x:Name="CommandList" Height="180" Background="#15102D" Foreground="#24FFE3" BorderBrush="#7944B5"
                                 SelectionChanged="CommandSelected" AutomationProperties.Name="{loc:DesktopLabel Ui.AdminCommands}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate>
                                <StackPanel Margin="3">
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Category}" Foreground="#D45CFF"/>
                                        <TextBlock Text="{Binding RiskBadge}" Foreground="{Binding RiskAccent}" FontSize="10" Margin="8,2,0,0"/>
                                    </WrapPanel>
                                    <Button Content="{Binding Command}" Tag="{Binding}" Click="CatalogCommandClicked" FontFamily="Consolas" HorizontalContentAlignment="Left">
                                        <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#24FFE3"/></DataTemplate></Button.ContentTemplate>
                                    </Button></StackPanel>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <ScrollViewer Grid.Column="1" Height="180" VerticalScrollBarVisibility="Auto" Margin="12,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="CommandDescription" Text="{loc:DesktopLabel Layout.SelectCommand}"/>
                                <TextBlock x:Name="CommandRisk" FontWeight="Bold" Margin="0,6,0,0"/>
                                <TextBlock x:Name="CommandImpact" Foreground="#FFB86C" Margin="0,2,0,2"/>
                                <TextBlock x:Name="CommandWhenUseful" Foreground="#39FF68" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock x:Name="CommandCaution" Foreground="#FFB86C" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                <ItemsControl x:Name="CommandParameters">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel><Button Content="{Binding Text}" ToolTip="{Binding Description}" Tag="{Binding}" Click="ParameterClicked" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#A8A4C5"/></StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <TextBlock Text="{loc:DesktopLabel Layout.CommandHelp}" Foreground="#A8A4C5" Margin="0,8"/>
                    <Separator/>
                    <TextBlock Text="{loc:DesktopLabel Ui.WindowsToolLab}" Foreground="#24FFE3" FontSize="18"/>
                    <TextBlock Text="{loc:DesktopLabel Layout.ManagedNotice}" Foreground="#A8A4C5"/>
                    <ComboBox x:Name="ManagedActions" ItemsSource="{x:Static services:ManagedActionTools.All}" DisplayMemberPath="Name" SelectedIndex="0" AutomationProperties.Name="{loc:DesktopLabel Layout.SafeWindowsTools}"/>
                    <TextBlock Foreground="#FFB86C">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding SelectedItem.Risk, ElementName=ManagedActions}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem.Action.Id, ElementName=ManagedActions}" Value="windows-update-install">
                                        <Setter Property="Text" Value="{loc:DesktopLabel Safety.UpdateInstallRisk}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <WrapPanel>
                        <Button Content="{loc:DesktopLabel Layout.ManagedExecute}" Click="ManagedActionClicked"/>
                        <Button Content="{loc:DesktopLabel Layout.UpdateSettings}" Click="UpdateSettingsClicked"/>
                    </WrapPanel>
                    <TextBlock Text="{loc:DesktopLabel Layout.ReviewedUpdateHeading}" Foreground="#D45CFF" Margin="0,8,0,0"/>
                    <TextBlock Text="{loc:DesktopLabel Layout.ReviewedUpdateNotice}" Foreground="#FFB86C"/>
                    <Button Content="{loc:DesktopLabel Layout.SearchUpdates}" Click="TypedUpdateSearchClicked" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="UpdatePlanStatus" Text="{loc:DesktopLabel Layout.UpdateInitial}" Foreground="#A8A4C5"/>
                    <ComboBox x:Name="ReviewedUpdates" DisplayMemberPath="Display" SelectionChanged="ReviewedUpdateSelected" AutomationProperties.Name="{loc:DesktopLabel Layout.ReviewedUpdateSelect}"/>
                    <TextBox x:Name="UpdateOfferDetails" IsReadOnly="True" Height="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:DesktopLabel Layout.UpdateIdentity}"/>
                    <CheckBox x:Name="UpdateEulaAcceptance" Content="{loc:DesktopLabel Layout.UpdateEulaAcceptance}" Foreground="#FFB86C"/>
                    <Button Content="{loc:DesktopLabel Layout.ReviewedUpdateInstall}" Click="TypedUpdateInstallClicked" HorizontalAlignment="Left"/>
                    <TextBlock Text="OPTIONAL / MICROSOFT SYSINTERNALS + ADK" Foreground="#D45CFF" Margin="0,8,0,0"/>
                    <ComboBox x:Name="OptionalTools" ItemsSource="{x:Static services:ManagedActionTools.OptionalTools}" DisplayMemberPath="Display" SelectedIndex="0" AutomationProperties.Name="{loc:DesktopLabel Ui.OptionalTools}"/>
                    <WrapPanel>
                        <Button Content="{loc:DesktopLabel Layout.OptionalAvailability}" Click="OptionalToolAvailabilityClicked"/>
                        <Button Content="{loc:DesktopLabel Ui.OfficialPage}" Click="OptionalToolDownloadClicked"/>
                    </WrapPanel>
                    <TextBlock Text="{loc:DesktopLabel Layout.OptionalNotice}" Foreground="#A8A4C5"/>
                    <Separator/>
                    <TextBlock Text="{loc:DesktopLabel Layout.GuidedActions}" Foreground="#24FFE3"/>
                    <ComboBox x:Name="MaintenanceActions" AutomationProperties.Name="{loc:DesktopLabel Ui.MaintenanceAction}"/>
                    <Button Content="{loc:DesktopLabel Layout.StartSelectedAction}" Click="MaintenanceClicked" HorizontalAlignment="Left"/>
                    <Button Content="{loc:DesktopLabel Layout.RestartExplorer}" Click="ExplorerClicked" HorizontalAlignment="Left"/>
                    <Button Content="{loc:DesktopLabel Layout.DeliveryCleanup}" Click="DeliveryClicked" HorizontalAlignment="Left"/>
                    <WrapPanel><Button Content="{loc:DesktopLabel Layout.Certificates}" Click="CertificatesClicked"/>
                        <Button Content="WHEA / Kernel / Bugchecks" Click="StabilityClicked"/></WrapPanel>
                    <TextBlock Text="{loc:DesktopLabel Layout.RepairNotice}" Foreground="#A8A4C5"/>
                    <Button Content="{loc:DesktopLabel Ui.JournalOpen}" Click="OpenJournalClicked" HorizontalAlignment="Left"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:DesktopLabel Module.Autostart}" Tag="Autostart" ToolTip="{loc:DesktopLabel Module.StartupTip}">
                <StackPanel Margin="14">
                    <TextBlock Text="{loc:DesktopLabel Ui.StartupHeading}" Foreground="#24FFE3" FontSize="19"/>
                    <TextBlock Text="{loc:DesktopLabel Layout.StartupNotice}" Margin="0,8,0,12"/>
                    <Button Content="{loc:DesktopLabel Ui.StartupRead}" Click="StartupReadClicked" HorizontalAlignment="Left"/>
                    <TextBox x:Name="StartupSearch" TextChanged="StartupSearchChanged" AutomationProperties.Name="{loc:DesktopLabel Ui.StartupFilter}" ToolTip="{loc:DesktopLabel Layout.StartupFilterTip}"/>
                    <DataGrid x:Name="StartupEntries" Height="140" SelectionMode="Single" SelectionChanged="StartupSelected" AutomationProperties.Name="{loc:DesktopLabel Layout.StartupEntry}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:DesktopLabel Layout.Active}" Binding="{Binding Enabled}" Width="60"/>
                            <DataGridTextColumn Header="{loc:DesktopLabel Layout.Source}" Binding="{Binding Hive}" Width="65"/>
                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="{loc:DesktopLabel Layout.Command}" Binding="{Binding Command}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox x:Name="StartupDetails" IsReadOnly="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:DesktopLabel Layout.StartupCommand}"/>
                    <WrapPanel><Button Content="{loc:DesktopLabel Layout.DisableStartup}" Tag="off" Click="StartupChangeClicked"/>
                        <Button Content="{loc:DesktopLabel Layout.EnableStartup}" Tag="on" Click="StartupChangeClicked"/></WrapPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="{loc:DesktopLabel Module.Spuren}" Tag="Spuren" ToolTip="{loc:DesktopLabel Module.TracesTip}">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:DesktopLabel Layout.ShellbagsHeading}" Foreground="#24FFE3" FontSize="19"/>
                        <TextBlock Text="{loc:DesktopLabel Layout.ShellbagsNotice}" Margin="0,6,0,6"/>
                        <Button Content="{loc:DesktopLabel Layout.ReadShellbags}" Click="ShellbagsClicked" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <DataGrid x:Name="ShellbagGrid" Grid.Row="1" MinHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:DesktopLabel Ui.PathColumn}" Binding="{Binding Name}" Width="3*"/>
                            <DataGridTextColumn Header="{loc:DesktopLabel Layout.Kind}" Binding="{Binding Kind}" Width="*"/>
                            <DataGridTextColumn Header="SLOT" Binding="{Binding Slot}" Width="60"/>
                            <DataGridTextColumn Header="{loc:DesktopLabel Layout.KeyWritten}" Binding="{Binding WrittenDisplay}" Width="*"/>
                            <DataGridTextColumn Header="{loc:DesktopLabel Layout.RegistrySource}" Binding="{Binding KeyPath}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ShellbagInfo" Grid.Row="2" Foreground="#32D5FF" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="{loc:DesktopLabel Layout.ShellbagInitial}"/>
                </Grid>
            </TabItem>
            <TabItem Header="{loc:DesktopLabel Ui.LogsTab}" Tag="Logs / Gaming" ToolTip="{loc:DesktopLabel Module.LogsTip}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
                    <TextBlock Text="{loc:DesktopLabel Ui.LogViewerHeading}" Foreground="#24FFE3" FontSize="19"/>
                    <WrapPanel><Button Content="{loc:DesktopLabel Ui.OpenJsonl}" Click="OpenLogClicked"/>
                        <Button Content="{loc:DesktopLabel Ui.CompareLog}" Click="CompareLogClicked"/></WrapPanel>
                    <ComboBox x:Name="LogSeries" SelectionChanged="LogSeriesChanged" AutomationProperties.Name="{loc:DesktopLabel Ui.LogSeries}"/>
                    <Viewbox Height="110" Stretch="Fill"><Canvas Width="800" Height="110">
                        <Polyline x:Name="LogCurve" Stroke="#24FFE3" StrokeThickness="2"/>
                    </Canvas></Viewbox>
                    <TextBlock x:Name="LogSummary" Margin="0,8,0,10" Foreground="#32D5FF"/>
                    <DataGrid x:Name="LogPoints" Height="110"><DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:DesktopLabel Layout.Timestamp}" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="2*"/>
                        <DataGridTextColumn Header="{loc:DesktopLabel Layout.Reading}" Binding="{Binding Value}" Width="*"/>
                    </DataGrid.Columns></DataGrid>
                    <WrapPanel>
                        <TextBox x:Name="GameProcess" Width="200" Text="Spiel.exe" AutomationProperties.Name="{loc:DesktopLabel Ui.GameProcess}"/>
                        <TextBox x:Name="CaptureSeconds" Width="80" Text="60" AutomationProperties.Name="{loc:DesktopLabel Layout.CaptureSeconds}"/>
                        <Button Content="PresentMon Capture" Click="CaptureClicked"/>
                        <Button Content="{loc:DesktopLabel Layout.AnalyzeFrames}" Click="FrameCsvClicked"/>
                        <Button Content="{loc:DesktopLabel Ui.CompareFrameCsv}" Click="CompareFramesClicked"/>
                    </WrapPanel>
                    <TextBlock Text="{loc:DesktopLabel Layout.PresentMonNotice}" Foreground="#A8A4C5"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:DesktopLabel Module.Einstellungen}" Tag="Einstellungen" ToolTip="{loc:DesktopLabel Module.SettingsTip}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
                    <TextBlock Text="{loc:DesktopLabel Layout.SettingsHeading}" Foreground="#24FFE3" FontSize="19"/>
                    <WrapPanel>
                        <Button Content="{loc:DesktopLabel Ui.DesktopSettings}" Click="DesktopSettingsClicked"/>
                        <Button Content="{loc:DesktopLabel Layout.NetworkMonitor}" Click="NetworkMonitorClicked"/>
                    </WrapPanel>
                    <WrapPanel>
                        <StackPanel Width="160"><TextBlock Text="{loc:DesktopLabel Ui.CpuWarning}"/><TextBox x:Name="CpuThreshold"/></StackPanel>
                        <StackPanel Width="160"><TextBlock Text="{loc:DesktopLabel Ui.GpuWarning}"/><TextBox x:Name="GpuThreshold"/></StackPanel>
                        <StackPanel Width="160"><TextBlock Text="{loc:DesktopLabel Ui.StorageWarning}"/><TextBox x:Name="StorageThreshold"/></StackPanel>
                        <StackPanel Width="160"><TextBlock Text="{loc:DesktopLabel Layout.FreeSpace}"/><TextBox x:Name="FreeThreshold"/></StackPanel>
                    </WrapPanel>
                    <WrapPanel>
                        <StackPanel Width="160"><TextBlock Text="{loc:DesktopLabel Ui.AtxTolerance}"/><TextBox x:Name="VoltageThreshold"/></StackPanel>
                        <StackPanel Width="160"><TextBlock Text="CMOS Minimum V"/><TextBox x:Name="CmosThreshold"/></StackPanel>
                        <StackPanel Width="160"><TextBlock Text="{loc:DesktopLabel Ui.LogInterval}"/><TextBox x:Name="RecordSeconds"/></StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{loc:DesktopLabel Ui.SmartTool}"/>
                    <WrapPanel><TextBox x:Name="SmartPath" Width="660"/><Button Content="{loc:DesktopLabel Layout.SelectSmartctl}" Tag="smart" Click="ToolPathClicked"/></WrapPanel>
                    <TextBlock Text="PresentMon Console EXE"/>
                    <WrapPanel><TextBox x:Name="PresentPath" Width="660"/><Button Content="{loc:DesktopLabel Layout.SelectPresentMon}" Tag="present" Click="ToolPathClicked"/></WrapPanel>
                    <TextBlock Text="{loc:DesktopLabel Layout.OuiNotice}"/>
                    <WrapPanel><TextBox x:Name="OuiPath" Width="660"/><Button Content="{loc:DesktopLabel Layout.SelectOui}" Click="OuiPathClicked"/></WrapPanel>
                    <Separator Margin="0,14"/>
                    <TextBlock Text="{loc:DesktopLabel Layout.ManagementReports}" Foreground="#24FFE3" FontSize="17"/>
                    <StackPanel Margin="0,6,0,8">
                        <TextBlock Text="{loc:DesktopLabel Ui.ClientMode}" Foreground="#A8A4C5"/>
                        <RadioButton x:Name="StandaloneMode" GroupName="ManagerMode" Content="{loc:DesktopLabel Layout.Standalone}" Checked="ManagerModeChanged"/>
                        <RadioButton x:Name="ManagedClientMode" GroupName="ManagerMode" Content="{loc:DesktopLabel Layout.ManagedClient}" Checked="ManagerModeChanged"/>
                    </StackPanel>
                    <TextBlock Text="{loc:DesktopLabel Layout.EnrollmentNotice}" Foreground="#A8A4C5" TextWrapping="Wrap" Margin="0,6,0,8"/>
                    <TextBlock Text="{loc:DesktopLabel Layout.ServerUrl}"/>
                    <TextBox x:Name="ManagerServerUrl" Width="620" HorizontalAlignment="Left"/>
                    <CheckBox x:Name="ManagerReportingToggle" Content="{loc:DesktopLabel Layout.ReportingConsent}" Margin="0,8,0,4"/>
                    <WrapPanel>
                        <PasswordBox x:Name="ManagerEnrollmentCode" Width="300" AutomationProperties.Name="{loc:DesktopLabel Ui.EnrollmentCode}"/>
                        <Button x:Name="EnrollManagerButton" Content="{loc:DesktopLabel Layout.Enroll}" Click="EnrollManagerClicked"/>
                    </WrapPanel>
                    <TextBlock x:Name="ManagerStatus" Text="{loc:DesktopLabel Layout.ManagementInitial}" Foreground="#24FFE3" TextWrapping="Wrap" Margin="0,6,0,8"/>
                    <TextBlock Text="{loc:DesktopLabel Ui.SkinSurface}"/>
                    <TextBlock Text="{loc:DesktopLabel Language.ReleaseNotice}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <WrapPanel>
                        <ComboBox x:Name="SkinSelect" Width="340" DisplayMemberPath="Display" SelectionChanged="SkinChanged" AutomationProperties.Name="{loc:DesktopLabel Layout.SkinSelection}"
                                  ToolTip="{loc:DesktopLabel Layout.SkinTip}"/>
                        <TextBlock x:Name="SkinHint" Text="{loc:DesktopLabel Layout.PreferencesNotice}" Foreground="#A8A4C5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <WrapPanel><Button Content="{loc:DesktopLabel Layout.SaveSettings}" Click="SaveSettingsClicked"/>
                        <Button Content="{loc:DesktopLabel Layout.SensorChecks}" Click="SensorChecksClicked"/></WrapPanel>
                    <TextBlock Text="{loc:DesktopLabel Layout.SensorLimits}" Foreground="#A8A4C5"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:DesktopLabel Module.Schluessel}" Tag="Schluessel" ToolTip="{loc:DesktopLabel Module.KeysTip}">
                <StackPanel Margin="14">
                    <TextBlock Text="{loc:DesktopLabel Layout.SensitiveHeading}" Foreground="#D45CFF" FontSize="19"/>
                    <TextBlock Text="{loc:DesktopLabel Layout.SecretsNotice}" Margin="0,12,0,16"/>
                    <TextBox x:Name="WifiProfile" Width="350" HorizontalAlignment="Left" AutomationProperties.Name="{loc:DesktopLabel Layout.SecretProfile}"/>
                    <WrapPanel><Button Content="{loc:DesktopLabel Layout.ShowWifiSecret}" Tag="wifi" Click="SecretClicked"/>
                        <Button Content="{loc:DesktopLabel Layout.ShowBitLockerSecret}" Tag="bitlocker" Click="SecretClicked"/>
                        <Button Content="{loc:DesktopLabel Layout.ShowOemSecret}" Tag="windows-key" Click="SecretClicked"/></WrapPanel>
                    <Button Content="{loc:DesktopLabel Layout.ClearSecrets}" Click="ClearOutputClicked" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <GridSplitter x:Name="TerminalSplitter" Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#6940A8" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ToolTip="{loc:DesktopLabel Layout.ConsoleHeight}"/>
        <Border x:Name="TerminalFrame" Grid.Row="3" CornerRadius="22" BorderBrush="#71847B" BorderThickness="3" Padding="10" Margin="0,6,0,8">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#637369" Offset="0"/><GradientStop Color="#1B2621" Offset="0.12"/>
                <GradientStop Color="#0C120F" Offset="0.7"/><GradientStop Color="#46584C" Offset="1"/>
            </LinearGradientBrush></Border.Background>
            <Border CornerRadius="15" Background="#010603" BorderBrush="#0B2113" BorderThickness="2" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <WrapPanel DockPanel.Dock="Right">
                            <CheckBox x:Name="CrtEffects" Content="{loc:DesktopLabel Ui.CrtGlass}" IsChecked="True" Foreground="#7BFFA6" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox x:Name="FollowOutput" Content="Autoscroll" IsChecked="True" Foreground="#7BFFA6" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button x:Name="ExpandTerminalButton" Content="{loc:DesktopLabel Terminal.Expand}" Click="ExpandTerminalClicked" Margin="0" Padding="8,3"/>
                        </WrapPanel>
                        <TextBlock x:Name="TerminalHeading" Text="AETHER VT // PHOSPHOR TERMINAL" Foreground="#62FF91" FontFamily="Consolas" FontWeight="Bold"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 Background="#000000" Foreground="#7BFFA6" BorderThickness="0" Padding="8"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                                 FontSize="14" Margin="0" AutomationProperties.Name="{loc:DesktopLabel Layout.ActionOutput}"
                                 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
                                 UseLayoutRounding="True" SnapsToDevicePixels="True"
                                 Text="{loc:DesktopLabel Layout.ConsoleInitial}"/>
                        <Grid x:Name="TerminalDecorations" IsHitTestVisible="False">
                            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=CrtEffects}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></Grid.Style>
                            <Border Background="{StaticResource Scanlines}"/>
                            <Border><Border.Background><RadialGradientBrush>
                                <GradientStop Color="#002DFF70" Offset="0.55"/><GradientStop Color="#20000000" Offset="1"/>
                            </RadialGradientBrush></Border.Background></Border>
                            <Border Height="65" VerticalAlignment="Top" CornerRadius="10">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0CFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background>
                            </Border>
                        </Grid>
                    </Grid>
                    <Grid x:Name="ShellControls" Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="PS ADMIN &gt;" Foreground="#7BFFA6" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="CommandInput" Grid.Column="1" Background="#000000" Foreground="#7BFFA6" FontFamily="Consolas"
                                 Margin="0" Padding="6" KeyDown="CommandInputKeyDown" AutomationProperties.Name="{loc:DesktopLabel Ui.ConsoleCommand}"
                                 ToolTip="{loc:DesktopLabel Layout.PowerShellNotice}"/>
                        <TextBox x:Name="CommandTimeout" Grid.Column="2" Text="120" Width="55" Margin="8,0" Padding="6"
                                 ToolTip="{loc:DesktopLabel Layout.TimeoutTip}" AutomationProperties.Name="{loc:DesktopLabel Layout.Timeout}"/>
                        <Button Grid.Column="3" Content="Start / Enter" Click="ShellRunClicked" Margin="0" Padding="8,3"/>
                    </Grid>
                    <TextBlock x:Name="TerminalInfo" Grid.Row="3" Text="{loc:DesktopLabel Layout.TerminalIdle}" Foreground="#62B97C" FontFamily="Consolas" Margin="0,8,0,0" FontSize="11"/>
                </Grid>
            </Border>
        </Border>
        <DockPanel Grid.Row="4">
            <Button Content="{loc:DesktopLabel Ui.CancelRunningAction}" Click="CancelClicked" DockPanel.Dock="Right"/>
            <TextBlock x:Name="Status" Text="{loc:DesktopLabel Layout.ControlReady}" Foreground="#32D5FF" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
