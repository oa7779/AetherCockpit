<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Skin: Candy-Glossy (dunkle Bonbon-Optik mit starken Glanzlichtern). -->
    <LinearGradientBrush x:Key="WindowBackdrop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E0A20"/><GradientStop Color="#0C040F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlossPanel" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#C2559A" Offset="0"/>
        <GradientStop Color="#531A4E" Offset="0.06"/>
        <GradientStop Color="#3D1240" Offset="0.3"/>
        <GradientStop Color="#240923" Offset="0.32"/>
        <GradientStop Color="#290B27" Offset="0.87"/>
        <GradientStop Color="#8A3579" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFE6F6"/>
        <GradientStop Color="#FF66B5" Offset="0.28"/>
        <GradientStop Color="#93307F" Offset="0.55"/>
        <GradientStop Color="#64DAFF" Offset="0.8"/>
        <GradientStop Color="#FFD4EE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlossButton" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EA78BE"/><GradientStop Color="#8A3172" Offset="0.47"/>
        <GradientStop Color="#4C1443" Offset="0.5"/><GradientStop Color="#6F285D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ChromeSidebar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3D1140"/><GradientStop Color="#18081D" Offset="0.08"/>
        <GradientStop Color="#200A24" Offset="0.85"/><GradientStop Color="#54164B" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonBorder" Color="#FF7CC6"/>
    <SolidColorBrush x:Key="ButtonBorderAlt" Color="#FF7CC6"/>
</ResourceDictionary>
