<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Skin: Windows 11 26H2 Fluent/Mica-Anmutung (dunkel, flach, dezente Konturen). -->
    <LinearGradientBrush x:Key="WindowBackdrop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1D1D1F"/><GradientStop Color="#171719" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlossPanel" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#303034" Offset="0"/>
        <GradientStop Color="#2A2A2E" Offset="0.06"/>
        <GradientStop Color="#28282C" Offset="0.3"/>
        <GradientStop Color="#252529" Offset="0.32"/>
        <GradientStop Color="#252529" Offset="0.87"/>
        <GradientStop Color="#2C2C30" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4A4A4E"/>
        <GradientStop Color="#56565A" Offset="0.28"/>
        <GradientStop Color="#3C3C40" Offset="0.55"/>
        <GradientStop Color="#60606A" Offset="0.8"/>
        <GradientStop Color="#4A4A4E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlossButton" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3C3C40"/><GradientStop Color="#353539" Offset="0.47"/>
        <GradientStop Color="#2F2F33" Offset="0.5"/><GradientStop Color="#323236" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ChromeSidebar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#202022"/><GradientStop Color="#1B1B1D" Offset="0.08"/>
        <GradientStop Color="#1D1D1F" Offset="0.85"/><GradientStop Color="#242426" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonBorder" Color="#5C5C64"/>
    <SolidColorBrush x:Key="ButtonBorderAlt" Color="#5C5C64"/>
</ResourceDictionary>
