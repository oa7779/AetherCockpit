<Window x:Class="AetherLocalAiSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AETHER – Lokale KI einrichten" Width="760" Height="700"
        MinWidth="680" MinHeight="620" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#090D1B" Foreground="#EAF8FF">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="#111A2B" />
            <Setter Property="BorderBrush" Value="#284259" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D6E7F5" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="AETHER" Foreground="#35E7FF" FontSize="13" FontWeight="Bold" />
            <TextBlock Text="Lokale KI einrichten" FontSize="27" FontWeight="SemiBold" Margin="0,2,0,0" />
            <TextBlock Text="Modellfreigabe erfolgt erst nach bestätigter Lizenz, geprüften Modelldaten und passender Hardware."
                       Foreground="#B4C7D8" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="CapabilityLabel" Text="System wird geprüft" FontSize="19"
                           FontWeight="SemiBold" Foreground="#35E7FF" />
                <TextBlock x:Name="CapabilityDetails" Foreground="#B4C7D8" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,4">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="System und Ressourcen" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="HardwareFacts" Foreground="#B4C7D8" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Ollama und Modellstore" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="RuntimeFacts" Foreground="#B4C7D8" Margin="0,8,0,0" />
                        <TextBlock Foreground="#B4C7D8" Margin="0,8,0,0">
                            <Run Text="Verwalteter AETHER-Modellstore: " />
                            <Run x:Name="ModelStorePathText" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Phi-4 Mini" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="ModelQualification" Foreground="#B4C7D8" Margin="0,8,0,0" />
                        <TextBlock Margin="0,8,0,0">
                            <Hyperlink x:Name="LicenseLink" NavigateUri="https://huggingface.co/microsoft/Phi-4-mini-instruct/blob/main/LICENSE"
                                       RequestNavigate="LicenseLink_OnRequestNavigate">
                                MIT-Lizenztext bei Microsoft anzeigen
                            </Hyperlink>
                        </TextBlock>
                        <CheckBox x:Name="LicenseAccepted" Content="Ich habe die Modelllizenz gelesen und stimme ihr zu."
                                  Checked="AcceptanceChanged" Unchecked="AcceptanceChanged" />
                        <CheckBox x:Name="StoreConfigurationAccepted"
                                  Content="Ich bestätige die Konfiguration des AETHER-Modellstores und seines Loopback-Endpunkts. Vorhandene Fremdmodelle bleiben unberührt."
                                  Checked="AcceptanceChanged" Unchecked="AcceptanceChanged" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Nemotron 3 Nano 4B · optionaler Kandidat" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="NemotronQualification" Foreground="#B4C7D8" Margin="0,8,0,0" />
                        <TextBlock Margin="0,8,0,0">
                            <Hyperlink x:Name="NemotronLicenseLink"
                                       NavigateUri="https://www.nvidia.com/en-us/agreements/enterprise-software/nvidia-open-model-license/"
                                       RequestNavigate="LicenseLink_OnRequestNavigate">
                                NVIDIA Open Model License anzeigen
                            </Hyperlink>
                        </TextBlock>
                        <CheckBox x:Name="NemotronLicenseAccepted" IsEnabled="False"
                                  Content="Ich habe die NVIDIA-Lizenz gelesen und stimme ihr für Nemotron ausdrücklich zu."
                                  Checked="AcceptanceChanged" Unchecked="AcceptanceChanged" />
                        <TextBlock Text="Nemotron 30B wird nicht standardmäßig heruntergeladen."
                                   Foreground="#B4C7D8" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3">
            <ProgressBar x:Name="SetupProgress" Height="8" IsIndeterminate="False" Visibility="Collapsed" />
            <TextBlock x:Name="ProgressStatus" Foreground="#B4C7D8" Margin="0,6,0,0" />
        </StackPanel>
        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <Button x:Name="SetupButton" Content="Lokale KI einrichten" Width="190" Height="38"
                    HorizontalAlignment="Left" IsEnabled="False" Click="SetupButton_OnClick"
                    Background="#123846" Foreground="#EAF8FF" BorderBrush="#35E7FF" />
            <Button Content="Schließen" Width="100" Height="38" Margin="12,0,0,0"
                    HorizontalAlignment="Right" DockPanel.Dock="Right" Click="CloseButton_OnClick" />
        </DockPanel>
    </Grid>
</Window>
