<Window x:Class="AetherLocalAiSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AETHER Local AI Setup" Width="860" Height="780"
        MinWidth="760" MinHeight="650" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="Transparent" Foreground="#EAF8FF" FontFamily="Segoe UI"
        Icon="Assets/aether.ico"
        AllowsTransparency="True"
        AutomationProperties.Name="AETHER Local AI Setup">
    <Window.Resources>
        <SolidColorBrush x:Key="Cyan" Color="#35E7FF"/>
        <SolidColorBrush x:Key="Magenta" Color="#F078FF"/>
        <SolidColorBrush x:Key="Muted" Color="#AFC6D8"/>
        <SolidColorBrush x:Key="Success" Color="#54F29A"/>
        <SolidColorBrush x:Key="Warning" Color="#FFC857"/>
        <SolidColorBrush x:Key="Error" Color="#FF6174"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF8FF"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#D9122034"/>
            <Setter Property="BorderBrush" Value="#35516C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14,4,14,4"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#112A45" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Foreground" Value="#EAF8FF"/>
            <Setter Property="Background" Value="#17384B"/>
            <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9,3,9,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#245269"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0B2737"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}"/>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D6E7F5"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsEnabled" Value="False"/>
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#D6E7F5"/>
            <Setter Property="BorderBrush" Value="#35516C"/>
        </Style>
    </Window.Resources>

    <Border Margin="5" CornerRadius="18,6,18,6" BorderBrush="#45E8FF" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#080B18" Offset="0"/>
                <GradientStop Color="#121029" Offset="0.52"/>
                <GradientStop Color="#07151F" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#0D8BA7" BlurRadius="18" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MinHeight="108" Background="#B00A1020"
                  MouseLeftButtonDown="WindowHeader_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="82" Height="82" Margin="18,12,14,12"
                        CornerRadius="14,4,14,4" BorderBrush="#F078FF" BorderThickness="1"
                        Background="#090713">
                    <Border.Effect>
                        <DropShadowEffect Color="#D72FFF" BlurRadius="18" ShadowDepth="0" Opacity="0.6"/>
                    </Border.Effect>
                    <Image x:Name="BrandLogo" Source="pack://application:,,,/AetherLocalAiSetup;component/Assets/aether-logo.png"
                           Stretch="Uniform" Margin="6"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="Wordmark" Text="A E T H E R" FontFamily="Arial Black"
                               FontStyle="Italic" FontWeight="Black" FontSize="25">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFF"/>
                                <GradientStop Color="#BFD4FF" Offset="0.42"/>
                                <GradientStop Color="#F6C8FF" Offset="0.55"/>
                                <GradientStop Color="#E54BC5" Offset="0.84"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#DC46E8" BlurRadius="8" ShadowDepth="1" Opacity="0.65"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="Local AI Setup" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,2"/>
                    <TextBlock x:Name="VersionText" Text="AETHER 0.7.0 Beta 54"
                               Foreground="{StaticResource Muted}" FontSize="11" FontFamily="Consolas"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,8,8,0">
                    <Button Content="—" MinWidth="38" Width="38" Height="28" Padding="0"
                            ToolTip="Minimieren" Click="MinimizeButton_OnClick"/>
                    <Button Content="×" MinWidth="38" Width="38" Height="28" Padding="0" Margin="6,0,0,0"
                            ToolTip="Schließen" Click="CloseButton_OnClick"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="22,18,22,12">
                <StackPanel>
                    <TextBlock Text="Kontrollierte lokale Einrichtung"
                               Foreground="{StaticResource Magenta}" FontFamily="Consolas"
                               FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="Modellfreigabe erfolgt erst nach bestätigter Lizenz, geprüften Modelldaten und passender Hardware."
                               Foreground="{StaticResource Muted}" Margin="0,5,0,14"/>

                    <Border x:Name="ResultPanel" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ResultAccent" Background="{StaticResource Cyan}" CornerRadius="2"/>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock x:Name="CapabilityLabel" Text="System wird geprüft" FontSize="20"
                                           FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/>
                                <TextBlock x:Name="CapabilityDetails" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PHI 4 MINI · QUALIFIZIERTER PFAD" Foreground="{StaticResource Cyan}"
                                       FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="phi4-mini:3.8b wird nur nach Lizenzbestätigung und Prüfung der vorhandenen Modelldaten freigegeben."
                                       Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
                            <TextBlock Margin="0,8,0,0">
                                <Hyperlink x:Name="LicenseLink"
                                           NavigateUri="https://huggingface.co/microsoft/Phi-4-mini-instruct/blob/main/LICENSE"
                                           RequestNavigate="LicenseLink_OnRequestNavigate">
                                    MIT-Lizenztext bei Microsoft anzeigen
                                </Hyperlink>
                            </TextBlock>
                            <CheckBox x:Name="LicenseAccepted" Content="Ich habe die Modelllizenz gelesen und stimme ihr zu."
                                      Checked="AcceptanceChanged" Unchecked="AcceptanceChanged"/>
                            <CheckBox x:Name="StoreConfigurationAccepted"
                                      Checked="AcceptanceChanged" Unchecked="AcceptanceChanged"/>
                        </StackPanel>
                    </Border>

                    <Expander Header="Technische Details" Margin="0,0,0,10" IsExpanded="False">
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="SYSTEM UND RESSOURCEN" Foreground="{StaticResource Cyan}"
                                           FontFamily="Consolas" FontSize="11"/>
                                <TextBlock x:Name="HardwareFacts" Foreground="{StaticResource Muted}" Margin="0,6,0,14"/>
                                <TextBlock Text="RUNTIME UND MODELLSTORE" Foreground="{StaticResource Cyan}"
                                           FontFamily="Consolas" FontSize="11"/>
                                <TextBlock x:Name="RuntimeFacts" Foreground="{StaticResource Muted}" Margin="0,6,0,4"/>
                                <TextBlock Foreground="{StaticResource Muted}" Margin="0,0,0,14">
                                    <Run Text="Verwalteter AETHER-Modellstore: "/>
                                    <Run x:Name="ModelStorePathText"/>
                                </TextBlock>
                                <TextBlock Text="MODELLQUALIFIKATION" Foreground="{StaticResource Cyan}"
                                           FontFamily="Consolas" FontSize="11"/>
                                <TextBlock x:Name="ModelQualification" Foreground="{StaticResource Muted}" Margin="0,6,0,14"/>
                                <TextBlock x:Name="ErrorDetailsHeading" Text="FEHLERDETAILS"
                                           Foreground="{StaticResource Error}" FontFamily="Consolas"
                                           FontSize="11" Visibility="Collapsed"/>
                                <TextBox x:Name="ErrorDetails" IsReadOnly="True" TextWrapping="Wrap"
                                         MinHeight="72" MaxHeight="180" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" Background="#080B12"
                                         Foreground="#F2B6BE" BorderBrush="#6B2934"
                                         Visibility="Collapsed" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Border Background="#143125" BorderBrush="{StaticResource Success}"
                            BorderThickness="1" CornerRadius="8,3,8,3" Padding="12"
                            Visibility="Collapsed" x:Name="SuccessNotice">
                        <StackPanel>
                            <TextBlock Text="AETHER Intelligence ist bereit"
                                       Foreground="{StaticResource Success}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Phi 4 Mini wurde für die lokale Verwendung durch AETHER eingerichtet und geprüft."
                                       Foreground="#BDEFD2" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#263F56" BorderThickness="0,1,0,0" Background="#CC090D18">
                <StackPanel Margin="22,12,22,16">
                    <ProgressBar x:Name="SetupProgress" Height="8" IsIndeterminate="False"
                                 Visibility="Collapsed" Foreground="{StaticResource Cyan}"
                                 Background="#18263A" BorderThickness="0"/>
                    <TextBlock x:Name="ProgressStatus" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                    <DockPanel Margin="0,14,0,0" LastChildFill="False">
                        <Button x:Name="SetupButton" Content="Lokale KI einrichten" Width="190"
                                IsEnabled="False" Click="SetupButton_OnClick"/>
                        <Button Content="Schließen" Width="100" Margin="12,0,0,0"
                                DockPanel.Dock="Right" Click="CloseButton_OnClick"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
