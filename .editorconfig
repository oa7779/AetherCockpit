root = true

[*]
charset = utf-8
insert_final_newline = true

[*.{cs,xaml,resx,csproj,props,targets,json,jsonc,xml,manifest,py,ps1,psm1,psd1,iss,sln,slnx,rc,config,bat,cmd,md,txt,yml,yaml}]
end_of_line = crlf

[*.{ps1,psm1,psd1,iss}]
charset = utf-8

[build/{Configure-ManagedClient,Install-ManagerServer,Manage-ClientService}.ps1]
charset = utf-8-bom

[build/{AetherCockpit,AetherManager}.iss]
charset = utf-8-bom

[tests/Smoke-UI.ps1]
charset = utf-8-bom

[.gitattributes]
end_of_line = crlf
